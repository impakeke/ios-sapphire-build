@@ -1132,12 +1146,14 @@ SYSCTL_PROC(_kern, OID_AUTO, sweet_usb_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLF
     0, 0, sysctl_sweet_usb_stats, "A", "USB Ethernet gadget state");
 
 /*
- * 0327: reclaim a completed bulk transfer the instant its TRB HWO bit clears,
- * on every poll (~1 ms) -- not only on the controller event, which gets lost
- * under load (the link then froze until the next bus reset). HWO clear means the
- * controller is done with the TRB, so taking it here is always safe; if the event
- * does arrive, xfer_active is already clear and the handler ignores it. ud_watch
- * keeps the slower force-rearm paths (HWO still set) on its 500 ms cadence.
+ * 0327, old data path only (sweetusb_reclaim=0 turns it off): on every poll, a bulk transfer
+ * whose TRB has HWO clear is taken as complete without waiting for its XferComplete. That is
