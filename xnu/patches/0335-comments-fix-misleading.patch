 extern "C" int sweet_reboot_mode_get(void);
diff --git a/osfmk/arm/caches.c b/osfmk/arm/caches.c
index 9bbdac8..6c8ac8d 100644
--- a/osfmk/arm/caches.c
+++ b/osfmk/arm/caches.c
@@ -383,11 +383,10 @@ platform_cache_flush_wimg(
 #else   /* __ARM_COHERENT_IO__ */
 
 /*
- * topaz/sweet: Apple SoCs keep DMA coherent with the CPU caches, so
- * flush_dcache/clean_dcache stay no-ops (making them real slowed the whole
- * kernel to a crawl: XNU calls them on every pmap/IOMD path). Drivers whose
- * hardware reads DRAM behind the caches (the MDP scanout, DSI command DMA)
- * call sweet_dcache_clean() on just their buffers.
+ * Only built with __ARM_COHERENT_IO__ (Apple SoCs, DMA coherent with the CPU caches), where
+ * flush_dcache/clean_dcache are no-ops. The SWEET/sapphire board config (SWEET.h) does not define
+ * __ARM_COHERENT_IO__, so this branch is not compiled for the phone: flush_dcache/clean_dcache
+ * (and flush_dcache64) are the real dc civac / dc cvac versions at the top of this file.
  */
 void sweet_dcache_clean(vm_offset_t addr, unsigned length);
 
@@ -550,11 +549,10 @@ platform_cache_flush_wimg(
 #endif  /* __ARM_COHERENT_IO__ */
 
 /*
- * topaz: cache maintenance that really happens. This kernel is built with the
- * Apple SoC config (__ARM_COHERENT_IO__), where clean_dcache/flush_dcache are
- * no-ops; the Qualcomm display (MDP), DSI command DMA and GPU SMMU read DRAM
- * behind the caches, so their buffers are cleaned (dc cvac) or cleaned and
- * invalidated (dc civac) to the point of coherency by these.
+ * topaz: cache maintenance by VA range, to the point of coherency, for the Qualcomm display
+ * (MDP), DSI command DMA and GPU SMMU, which read DRAM behind the caches: clean (dc cvac) or
+ * clean and invalidate (dc civac). Compiled in every config. On the phone (SWEET.h, no
+ * __ARM_COHERENT_IO__) flush_dcache/clean_dcache are real too, not no-ops.
  */
 void sweet_dcache_clean(vm_offset_t addr, unsigned length);
 void sweet_dcache_flush(vm_offset_t addr, unsigned length);
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index cfeb976..ef5eb0f 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -1,6 +1,8 @@
 /*
  * Board config for the Redmi Note 10 Pro ("sweet", Qualcomm SM7150 /
  * Snapdragon 732G): Kryo 470 = Cortex-A76 + Cortex-A55, ARMv8.2, no PAC.
+ * The same config builds the sapphire/topaz kernel (Qualcomm SM6225: Cortex-A53 +
+ * Cortex-A73, ARMv8.0: no PAN, no PAC).
  *
  * Generic ARM like BCM2837 (no APPLE_ARM64_ARCH_FAMILY: none of Apple's
  * implementation-defined system registers exist), 16K pages and GICv3 like
@@ -20,7 +22,8 @@
 /*
  * All eight cores as one homogeneous SMP cluster (topaz: four A53 at
  * MPIDR 0x0-0x3 + four A73 at 0x100-0x103; sweet: six A55 + two A76):
- * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
+ * cpus=N is clamped here. Same ISA level within each phone (topaz/sapphire:
+ * ARMv8.0, no PAN; sweet: ARMv8.2), 64-byte lines, PSCI
  * CPU_ON; the scheduler does not know the A76s are faster (no AMP/P-E
  * clusters yet).
  */
