 		int want = 2;
 		PE_parse_boot_argn("sweetusb_dp", &want, sizeof(want));
 		ud_dp = (want == 2) ? 2 : 0;
@@ -2123,7 +2138,7 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	ud_if_create();
 
 	/*
-	 * 0331 (E3, behind sweetusb_utmipipe=1; default 0 = unchanged): use the UTMI clock as the
+	 * 0331 (sweetusb_utmipipe, default 1; 0 disables): use the UTMI clock as the
 	 * PIPE clock, as Linux dwc3-qcom does for an HS-only controller (dwc3_qcom_select_utmi_clk,
 	 * binding qcom,select-utmi-as-pipe-clk: "disable USB3 pipe_clk requirement"). 0329 showed that
 	 * on a normal boot GCC gcc_usb3_prim_phy_pipe_clk (CBCR 0x1a058) reads 0x80000001 (enabled but
@@ -2154,7 +2169,9 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 			}
 		}
 	}
-	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
+	/* Device controller soft reset. The PHY and the global registers are not programmed here (only
+	 * GUSB2PHYCFG below and, in v2, GUCTL2): they keep what the boot path left, which on a normal
+	 * boot is reset values (investigacion/03 E2). */
 	dwc_wr(DCTL, DCTL_CSFTRST);
 	int i;
 	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
@@ -2166,10 +2183,11 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 		return;
 	}
 
-	/* 0328: endpoint commands (SETEPCONFIG) need the UTMI PHY awake. Clear GUSB2PHYCFG SUSPHY
-	 * (bit 6) + ENBLSLPM (bit 8), as Linux dwc3 does around every ep command. Our boot path
-	 * (set_active+reboot, not `fastboot boot`) can leave the PHY suspended, so SETEPCONFIG on ep0
-	 * hung ("ep0 cmd timeout"), bring-up aborted, and the gadget never pulled up D+ / enumerated. */
+	/* 0328: clear GUSB2PHYCFG SUSPHY (bit 6) + ENBLSLPM (bit 8) once; Linux dwc3 clears them around
+	 * every ep command (data path v2 does too, dp_cmd). On a normal boot SUSPHY is already 0 and
+	 * ENBLSLPM is 1 (GUSB2PHYCFG 0x2500), but clearing them does not cure the ep0 SETEPCONFIG
+	 * timeout there: that comes from the USB3 PIPE clock being off, which the UTMI-as-PIPE
+	 * selection above fixes (investigacion/03 E1-E3). */
 	dwc_wr(0xc200, dwc_rd(0xc200) & ~((1u << 6) | (1u << 8)));
 	if (ud_dp) {
 		ud_dp_core_init();
diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index a46c3e2..cc6f033 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -24,9 +24,10 @@ public:
 /*
  * sapphire 0221: restart and power off. Nothing set PE_halt_restart, so both did nothing and
  * XNU panicked after unmounting. Restart writes the reboot reason ABL reads (PMIC PON spare)
- * and asks PSCI for SYSTEM_RESET; halt is PSCI SYSTEM_OFF. iOS is started with fastboot boot,
- * so a plain restart would come up in Android: the default is the bootloader (fastboot).
- * kern.sweet_reboot_mode (or boot-arg sweet_reboot): 0 system, 1 recovery, 2 bootloader.
+ * and asks PSCI for SYSTEM_RESET; halt is PSCI SYSTEM_OFF. The default is the bootloader
+ * (fastboot). kern.sweet_reboot_mode (or boot-arg sweet_reboot): 0 system = a normal boot of the
+ * GPT's active slot (iOS when iOS's slot is active, as installed), 1 recovery, 2 bootloader.
+ * See bsd/dev/sweet_reboot.c.
  */
