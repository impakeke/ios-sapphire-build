@@ -2100,9 +2116,8 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 
 	ud.dwc = dwc;
 	{
-		/* 0333: default 2 chosen here, at the same point 0330 read the boot-arg, never as the
-		 * variable's initial value: 0332's `static int ud_dp = 2` let the v2 paths run before
-		 * gadget_start had set them up (hang on a normal boot, 2026-11-14 E5). */
+		/* sweetusb_dp: default 2, applied here where the boot-arg is read; ud_dp stays 0 until
