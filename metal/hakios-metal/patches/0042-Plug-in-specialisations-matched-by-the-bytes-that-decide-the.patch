+	if ((hm_align() & 2) || ![up.super_class instancesRespondToSelector:_cmd]) {
+		return 64;
+	}
+	return ((NSUInteger (*)(struct objc_super *, SEL, MTLPixelFormat))objc_msgSendSuper)(&up, _cmd, format);
 }
 
