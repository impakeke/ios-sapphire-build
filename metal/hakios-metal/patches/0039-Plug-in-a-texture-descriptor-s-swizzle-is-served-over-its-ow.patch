+        std::string why;
+        auto v = Texture::swizzled(u, bgra, &why);
+        CHECK(v != nullptr && v->memoryless());
+    }
     // one pass of the caller's in two here: the second draw's options are another's, and it cannot join
     {
         Rig r;
