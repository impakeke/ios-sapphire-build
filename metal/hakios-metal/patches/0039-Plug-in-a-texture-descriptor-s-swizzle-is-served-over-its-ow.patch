 		hm_print("timeline: a texture of %lux%lu, format %lu, usage %#lx, over surface %u\n", (unsigned long)[descriptor width],
@@ -4982,6 +4975,20 @@ - (id)newTextureWithDescriptor:(MTLTextureDescriptor *)descriptor iosurface:(IOS
 	return t;
