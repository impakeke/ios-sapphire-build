diff --git a/hakios-metal/tests/main.cpp b/hakios-metal/tests/main.cpp
index bd037ec..a4e6e6b 100644
--- a/hakios-metal/tests/main.cpp
+++ b/hakios-metal/tests/main.cpp
@@ -1,18 +1,44 @@
 #include <cstring>
 
+#include "golden.hpp"
 #include "test.hpp"
 
+// tests [--golden] [NAME]: every test whose name holds NAME. With --golden, instead of the verdicts, what each test
+// submitted to the fake GPU, summed (golden.hpp): a line a test, compared with tests/golden/tests-<chip>.txt by
+// `make -f tools/dev.mk check`.
 int main(int argc, char** argv) {
     int ran = 0;
+    bool sums = false;
+    const char* only = nullptr;
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--golden") == 0) sums = true;
+        else only = argv[i];
+    }
+    golden::Sums s;
+    if (sums) golden::sumInto(&s);
+    // tests whose submissions depend on which thread got there first (a command buffer let go while the GPU has it:
+    // whether its memory is back in the queue's pools when the next one asks is the race the test is about), so that
+    // the addresses in their streams differ from run to run: counted, not summed
+    static const char* const kTimed[] = {"a_command_buffer_released_in_flight_gives_its_buffers_back"};
     for (const test::Case& c : test::cases()) {
-        if (argc > 1 && strstr(c.name, argv[1]) == nullptr) {
+        if (only != nullptr && strstr(c.name, only) == nullptr) {
             continue;
         }
         int before = test::failures();
+        s.reset();
         c.run();
-        std::printf("%s %s\n", test::failures() == before ? "ok  " : "FAIL", c.name);
+        if (sums) {
+            bool timed = false;
+            for (const char* t : kTimed) timed |= strcmp(t, c.name) == 0;
+            // (a test that submits nothing says so with zeros: its line still tells a test added or taken away)
+            std::printf("%s submits %u words %llu draws %u loads %u stream %016llx state %016llx%s%s\n", c.name, s.submits, (unsigned long long)s.words, s.draws,
+                        s.loads, (unsigned long long)(s.submits && !timed ? s.stream : 0), (unsigned long long)(s.submits && !timed ? s.state : 0),
+                        s.bad ? " (unread)" : "", timed ? " (by timing: not summed)" : "");
+        } else {
+            std::printf("%s %s\n", test::failures() == before ? "ok  " : "FAIL", c.name);
+        }
         ran++;
     }
-    std::printf("%d tests, %d failed checks\n", ran, test::failures());
+    if (!sums) std::printf("%d tests, %d failed checks\n", ran, test::failures());
     return test::failures() == 0 ? 0 : 1;
 }
diff --git a/hakios-metal/tools/dev.mk b/hakios-metal/tools/dev.mk
new file mode 100644
index 0000000..b8fe8ee
--- /dev/null
+++ b/hakios-metal/tools/dev.mk
@@ -0,0 +1,53 @@
+# tools/dev.mk: the host tests and drawbench built object by object and in parallel, for either chip's constants
+# (the Makefile's own `make test` compiles every source in one compiler run, a minute each time).
+#
+#   make -f tools/dev.mk -j4 [CHIP=a635|a610] [OPT="-O2 -g"] tests       out/dev-$(CHIP)/tests
+#   make -f tools/dev.mk -j4 [CHIP=...] drawbench                       out/dev-$(CHIP)/drawbench (tools/drawbench.cpp)
+#   make -f tools/dev.mk -j4 [CHIP=...] check                           the tests, then the golden streams (tests/golden/)
+#   make -f tools/dev.mk -j4 [CHIP=...] golden                          write the golden streams again (a change of the stream, said in its commit)
+#
+# CHIP=a610 builds with -DHAKIOS_CHIP_A610, the constants the phone's bundle is built with (make ios CHIP=a610).
+CHIP ?= a635
+CXX  ?= c++
+OPT  ?= -O2 -g
+OUT   = out/dev-$(CHIP)
+DEFS  = $(if $(filter a610,$(CHIP)),-DHAKIOS_CHIP_A610)
+CXXFLAGS = $(OPT) -std=c++17 -Wall -Wextra -Werror -Iinclude $(DEFS) -MMD -MP
