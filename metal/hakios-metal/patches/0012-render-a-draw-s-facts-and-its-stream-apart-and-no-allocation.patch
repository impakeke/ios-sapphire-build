 }
 
+uint32_t* Stream::open(uint32_t opcode, uint32_t count) {
+    command(opcode, count);
+    const size_t at = words_.size();
+    words_.resize(at + count);
+    return words_.data() + at;
+}
+
 }  // namespace hakios::metal::pm4
