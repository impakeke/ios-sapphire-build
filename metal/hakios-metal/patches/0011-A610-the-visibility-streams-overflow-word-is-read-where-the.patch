Subject: A610: the visibility streams' overflow word is read where the stream writes it

render::encodeGmem lays the visibility streams' memory out by the chip's number of pipes (a6xx::kNumVscPipes: 32 on
the A635, 16 on the A610 since the A610 patch) and tells the command processor to mark an overrun in the sizes
page behind the draw streams. CommandQueue::checkVsc read the word at a fixed 32 pipes: on the A610 that is a word
of pipe 1's primitive stream, so an overrun went unseen -- the binning stays on, and the tiles of an overrun pipe
miss draws -- while a nearly full primitive stream could turn the binning off by itself.

render::vscOverflowWordAt() is the one place that says where the word lies; the test holds the stream's own
CP_COND_WRITE5 packets to it.


---
diff --git a/hakios-metal/include/hakios-metal/render.hpp b/hakios-metal/include/hakios-metal/render.hpp
index a7046e6..7dc0aa3 100644
--- a/hakios-metal/include/hakios-metal/render.hpp
+++ b/hakios-metal/include/hakios-metal/render.hpp
@@ -544,6 +544,9 @@ constexpr uint64_t kVscSizesBytes = 0x1000;
 constexpr uint64_t kVscOverflowAt = 0x7f0;   // (in the sizes page: nonzero once a pass's streams overran a pipe's pitch, render::encodeGmem)
 constexpr uint64_t kVscTraceAt = 0x800;   // (in the sizes page, past the 32 pipes' words: gmemBinningTrace's word)
 constexpr uint64_t vscBytes() { return 32ull * (kVscDrawPitch + kVscPrimPitch) + kVscSizesBytes; }
+// where in that memory the overflow word lies: in the sizes page, which follows the draw streams of as many pipes as
+// the chip has (encodeGmem's layout: 32 on the A635, 16 on the A610) -- what CommandQueue::checkVsc reads
+constexpr uint64_t vscOverflowWordAt() { return uint64_t(a6xx::kNumVscPipes) * kVscDrawPitch + kVscOverflowAt; }
 // A Clear done in a tile by the event blit rather than by the 2D engine into memory and loaded back: the colour packed
 // as turnip packs it for RB_BLIT_CLEAR_COLOR (pack_blit_event_clear_value: the format's base, RGBA order, sRGB encoded)
 // -- 8-bit four-channel unorm and sRGB, and RGBA16Float; false for a format left to the fill
diff --git a/hakios-metal/src/command.cpp b/hakios-metal/src/command.cpp
index e48eb6d..bf31527 100644
--- a/hakios-metal/src/command.cpp
+++ b/hakios-metal/src/command.cpp
@@ -268,7 +268,10 @@ std::shared_ptr<Buffer> CommandQueue::vscBuffer(std::string* why) {
 void CommandQueue::checkVsc() {
     std::lock_guard<std::mutex> g(lock_);
     if (vsc_ == nullptr || vsc_->contents() == nullptr) return;
-    const uint32_t word = *reinterpret_cast<const volatile uint32_t*>(static_cast<const uint8_t*>(vsc_->contents()) + 32ull * render::kVscDrawPitch + render::kVscOverflowAt);
+    // (where render::encodeGmem tells the command processor to put it: past the draw streams of the chip's own number
+    // of pipes -- 32 on the A635, 16 on the A610, where a fixed 32 read a primitive stream's words instead and an
+    // overrun went unseen)
+    const uint32_t word = *reinterpret_cast<const volatile uint32_t*>(static_cast<const uint8_t*>(vsc_->contents()) + render::vscOverflowWordAt());
     if (word != 0) vscOverflowed_ = true;
 }
 
diff --git a/hakios-metal/tests/render_test.cpp b/hakios-metal/tests/render_test.cpp
index 046e170..1235dcc 100644
--- a/hakios-metal/tests/render_test.cpp
+++ b/hakios-metal/tests/render_test.cpp
@@ -5785,8 +5785,26 @@ TEST(a_visibility_stream_overflow_turns_the_binning_off) {
     auto v = r.queue->vscBuffer(&why);
     CHECK(v != nullptr);
     if (v == nullptr) return;
-    // the word as the compare writes it: the fake's VSC leaves its size registers at 0, so the overrun is put there by hand
-    *reinterpret_cast<uint32_t*>(static_cast<uint8_t*>(v->contents()) + 32ull * render::kVscDrawPitch + render::kVscOverflowAt) = 2;
+    // the word as the compare writes it: the fake's VSC leaves its size registers at 0, so the overrun is put there by
+    // hand -- where the stream's own compares (CP_COND_WRITE5, their words 5 and 6 the address) are told to write it
+    {
+        pm4::Stream tiles;
+        render::GmemPlan plan;
+        CHECK(render::gmemPlan(a, &plan, nullptr));
+        render::encodeGmem(tiles, a, plan, v->gpuAddress(), 1, v->gpuAddress(), o, 1, 1, false, 0, nullptr, v->gpuAddress());
+        const std::vector<uint32_t>& w = tiles.words();
+        uint32_t compares = 0;
+        for (size_t i = 0; i < w.size();) {
+            const pm4::Header h = pm4::decode(w[i]);
+            if (h.kind == pm4::Header::kCommand && h.opcode == a6xx::CP_COND_WRITE5 && h.count == 8) {
+                compares++;
+                CHECK_EQ(uint64_t(w[i + 6]) | uint64_t(w[i + 7]) << 32, v->gpuAddress() + render::vscOverflowWordAt());
+            }
+            i += 1 + h.count;
+        }
+        CHECK(compares != 0);
+    }
+    *reinterpret_cast<uint32_t*>(static_cast<uint8_t*>(v->contents()) + render::vscOverflowWordAt()) = 2;
     CHECK_EQ(pass(), 1u);   // (binned still: the word is read once this one completes)
     CHECK(!r.queue->binningOk());
     CHECK_EQ(pass(), 0u);
