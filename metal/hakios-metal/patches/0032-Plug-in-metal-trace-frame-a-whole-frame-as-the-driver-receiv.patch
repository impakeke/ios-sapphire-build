+/* ============================================================================================================
+ * The frame trace: metal_trace=frame
+ * ============================================================================================================ */
+
+/*
+ * metal_trace=1 says each kind of draw once, on the console. metal_trace=frame answers the other question: what ONE
+ * frame of the window server's is made of, all of it, as this driver was given it and as the GPU ran it. While the
+ * switch is on a thread looks at /var/tmp/metal.trace every 100 ms; each time the file appears or is touched again (its
+ * inode or its modification time moves), the next K command buffers this process makes are recorded whole, from their
+ * making to their completion, and written to /var/tmp/metal-trace-PID-N.txt, N the capture's number in the process.
+ * K is metal_trace_cbs=K (8 when not given); a number written in the file wins, and a word proc=NAME in it limits that
+ * capture to the process of that name. With metal_trace_every=S a capture is also armed every S seconds, and
+ * metal_trace_dir=DIR writes the files there instead of /var/tmp (the trigger stays where it is). The console
+ * gets one line when a capture is armed and one when its last command buffer is written; the rest goes to the file, by
+ * a queue of its own, so that no thread that draws waits on the flash.
+ *
+ * The file is lines, one record each: a word saying what the record is, then key=value fields, a value with a space,
+ * a quote or an '=' in it in double quotes with \" and \\. trace-frame.py (the research tree's) reads it. The records:
+ *   trace     the capture: process, pid, its number, K, why it was armed, the switches
+ *   cb        a command buffer, written when it is done with, its own lines after it: label, queue, made, committed,
+ *             scheduled and completed (host seconds, mach_absolute_time's), GPU time, status, what the core counted
+ *   enc       an encoder as it is made (render, parallel, blit, compute); endenc as it ends, with its label
+ *   att       a render encoder's attachment: slot, texture, level, slice, load and store actions as Metal gave them,
+ *             the clear value
+ *   tex       a texture, the first time the command buffer names it: id, the memory it is (s<IOSurface id> or the root
+ *             texture's t<id>, with the level and slice it starts at there), shape, format, usage, asked storage
+ *   samp      a sampler the same way: filters, address modes
+ *   pipe      a render pipeline, the first time the buffer draws with it: label, functions and their labels, the
+ *             constants they were specialised with, where each stage's code came from (CoreAnimation's variant, the
+ *             nearest one standing in, a stand-in function, its own), framebuffer fetch; pblend its blend per attachment
+ *   draw      a draw: pipeline, program, primitive, counts, viewport, scissor, the pixels it can touch and those its
+ *             vertices land on, the uber shader's specialisation, the core's pass it went into, what became of it;
+ *             dtex, dsamp and dbuf what it had bound
+ *   blit      a copy, fill, mipmap, resolve or rotation; dispatch a compute dispatch (with its dtex/dsamp/dbuf)
+ *   clear     a pass that only clears, recorded at its encoder's end
+ *   debug     a debug group pushed or popped, a signpost (where the base classes take them)
+ *   present, event   a drawable presented, an event signalled or waited for
+ *   gpass     a pass of the core's as the GPU ran it, written at completion: kind, size, draws, microseconds, GMEM and
+ *             its tiles, or sysmem and why. A draw's core= is its index here; the core times the first 64 passes
+ *   endcb     the command buffer's end; endtrace the capture's
+ * The cost while the switch is off is its reading, once, and one test of it where a command buffer is made: a buffer
+ * that is not recorded carries a NULL, which is all an encoder, a draw or a copy looks at.
+ */
+
+#define HM_FT_TRIGGER "/var/tmp/metal.trace"
+
+static BOOL hm_ft_enabled;            /* metal_trace=frame is on (hm_ft_mode has read the switches) */
+static unsigned hm_ft_cbs = 8;        /* metal_trace_cbs: the command buffers one capture takes */
+static double hm_ft_every;            /* metal_trace_every: seconds between captures the clock arms, 0 none */
+static char hm_ft_dir[128] = "/var/tmp";   /* metal_trace_dir: where the capture files go */
+static unsigned (*hm_ft_fs_traits)(hakios_metal_program *);   /* the core's hakios_metal_program_fs_traits, when it has it */
+static char hm_ft_asked_key;          /* the name a stand-in function was asked for under (objc_setAssociatedObject) */
+
+/* one capture: its file, its command buffers taken and written (under hm_ft.lock), and closed once no more will be */
+struct hm_ft_capture {
+	unsigned number, taken, written;
+	BOOL closed;
+	size_t bytes;
+	char path[192];
+};
+
+static struct {
+	pthread_mutex_t lock;
+	int armed;                         /* command buffers the current capture still takes */
+	unsigned captures, serial;         /* captures armed, command buffers recorded, in this process */
+	struct hm_ft_capture *capture;     /* the one the next command buffers join */
+} hm_ft = { PTHREAD_MUTEX_INITIALIZER, 0, 0, 0, NULL };
+
+/* a command buffer being recorded: its lines so far, and what its cb line will say */
+struct hm_ft_rec {
+	pthread_mutex_t lock;              /* a parallel encoder's sub-encoders record from several threads */
+	char *buf;
+	size_t len, cap;
+	struct hm_ft_capture *capture;
+	unsigned seq, serial;              /* its place in the capture (1..K) and among the process's recorded buffers */
+	unsigned encoders, draws, ops;     /* encoders made, draws, and blits and dispatches, each numbered from 0 */
+	unsigned unprofiled;               /* passes a parallel encoder's sub-encoders appended: the core times none of them */
+	double created, committed, scheduled, completed;
+	int phases;                        /* -commit's return and the completion: the second of them writes the record */
+	BOOL held, committedYet;           /* committed to the GPU once the events it waits for had come; -commit seen */
+	NSMutableIndexSet *named;          /* the textures, samplers and pipelines described in it (one counter numbers all) */
+};
+
+/* how a trace describes a render pipeline, made with it */
+struct hm_ft_pipe {
+	char *lines;                       /* its pipe line and a pblend line per colour attachment */
+	unsigned vdFormat, vdOffset, vdBuffer, vdStride;   /* attribute 0 of its vertex descriptor; vdFormat 0: none */
+	BOOL fixedVert, baseColor;         /* CoreAnimation's fixed_vert_*_gen, which reads its vertices itself; its fc_base_color */
+};
+
+static void *hm_ft_watch(void *unused);
+static void hm_ft_debug_methods(void);
+
+/* the switches, once: metal_trace=frame, metal_trace_cbs=K, metal_trace_every=S; the watcher started when it is on */
+static BOOL
+hm_ft_mode(void)
+{
+	static dispatch_once_t once;
+
+	dispatch_once(&once, ^{
+		char args[1024] = "", every[48] = "";
+		size_t size = sizeof(args) - 1;
+		const char *at;
+		pthread_t thread;
+
+		if (hm_bootargs(args, &size) != 0 || strstr(args, "metal_trace=frame") == NULL) {
+			return;
+		}
+		if ((at = strstr(args, "metal_trace_cbs=")) != NULL && atoi(at + strlen("metal_trace_cbs=")) > 0) {
+			hm_ft_cbs = (unsigned)MIN(atoi(at + strlen("metal_trace_cbs=")), 1000);
+		}
+		if ((at = strstr(args, "metal_trace_every=")) != NULL && atof(at + strlen("metal_trace_every=")) > 0) {
+			hm_ft_every = MAX(atof(at + strlen("metal_trace_every=")), 0.5);
+			snprintf(every, sizeof(every), ", and one every %.1f s", hm_ft_every);
+		}
+		if ((at = strstr(args, "metal_trace_dir=")) != NULL && at[strlen("metal_trace_dir=")] == '/') {
+			at += strlen("metal_trace_dir=");
+			snprintf(hm_ft_dir, sizeof(hm_ft_dir), "%.*s", (int)MIN(strcspn(at, " "), sizeof(hm_ft_dir) - 1), at);
+		}
+		/* (a core with the second patch says what a fragment stage reads by framebuffer fetch; without it the trace
+		 * falls back on CoreAnimation's fc_framebuffer_fetch constant) */
+		hm_ft_fs_traits = (unsigned (*)(hakios_metal_program *))dlsym(RTLD_SELF, "hakios_metal_program_fs_traits");
+		hm_ft_enabled = YES;
+		hm_ft_debug_methods();
+		if (pthread_create(&thread, NULL, hm_ft_watch, NULL) == 0) {
+			pthread_detach(thread);
+		}
+		hm_print("frame trace: on, %u command buffers a capture into %s when %s is touched%s; framebuffer fetch %s\n", hm_ft_cbs, hm_ft_dir,
+			 HM_FT_TRIGGER, every, hm_ft_fs_traits != NULL ? "as the core compiled it" : "from fc_framebuffer_fetch (no hakios_metal_program_fs_traits in the core)");
+	});
+	return hm_ft_enabled;
+}
+
+/* S as a field's value into OUT: bare when it is one word of plain characters, else in double quotes with \" and \\
+ * (a line break or a tab a space); "" for NULL or empty. OUT is returned. */
+static const char *
+hm_ft_q(char *out, size_t size, const char *s)
+{
+	size_t o = 0;
+	BOOL bare = s != NULL && s[0] != '\0';
+
+	if (size < 3) {
+		if (size != 0) out[0] = '\0';
+		return out;
+	}
+	if (s == NULL) s = "";
+	for (const char *p = s; bare && *p != '\0'; p++) {
+		bare = (unsigned char)*p > ' ' && (unsigned char)*p < 0x7f && *p != '"' && *p != '\\' && *p != '=';
+	}
+	if (bare) {
+		strlcpy(out, s, size);
+		return out;
+	}
+	out[o++] = '"';
+	for (const char *p = s; *p != '\0' && o + 3 < size; p++) {
+		const char c = *p == '\n' || *p == '\r' || *p == '\t' ? ' ' : *p;
+
+		if (c == '"' || c == '\\') out[o++] = '\\';
+		out[o++] = c;
+	}
+	out[o++] = '"';
+	out[o] = '\0';
+	return out;
+}
+
+static const char *
+hm_ft_qs(char *out, size_t size, NSString *s)
+{
+	return hm_ft_q(out, size, s != nil && [s isKindOfClass:[NSString class]] ? [s UTF8String] : NULL);
+}
+
+/* N bytes from P into OUT (2N + 1 chars) as hex */
+static const char *
+hm_ft_hex(char *out, const uint8_t *p, size_t n)
+{
+	static const char digits[] = "0123456789abcdef";
+
+	for (size_t i = 0; i < n; i++) {
+		out[2 * i] = digits[p[i] >> 4];
+		out[2 * i + 1] = digits[p[i] & 15];
+	}
+	out[2 * n] = '\0';
+	return out;
+}
+
+static uint32_t
+hm_ft_fnv(const void *p, size_t n, uint32_t h)
+{
+	for (size_t i = 0; i < n; i++) h = (h ^ ((const uint8_t *)p)[i]) * 16777619u;
+	return h;
+}
+
+/* FMT appended at *AT of OUT, never past SIZE */
+static void hm_ft_cat(char *out, size_t size, size_t *at, const char *fmt, ...) __attribute__((format(printf, 4, 5)));
+
+static void
+hm_ft_cat(char *out, size_t size, size_t *at, const char *fmt, ...)
+{
+	va_list ap;
+	int n;
+
+	if (*at + 1 >= size) return;
+	va_start(ap, fmt);
+	n = vsnprintf(out + *at, size - *at, fmt, ap);
+	va_end(ap);
+	if (n > 0) *at = MIN(*at + (size_t)n, size - 1);
+}
