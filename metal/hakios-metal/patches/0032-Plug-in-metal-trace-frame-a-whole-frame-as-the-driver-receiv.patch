+/* a colour write mask (MTLColorWriteMask: red 8, green 4, blue 2, alpha 1) as its letters */
+static const char *
+hm_ft_mask(unsigned m, char out[8])
+{
+	size_t o = 0;
+
+	if (m & 8) out[o++] = 'r';
+	if (m & 4) out[o++] = 'g';
+	if (m & 2) out[o++] = 'b';
+	if (m & 1) out[o++] = 'a';
+	if (o == 0) strlcpy(out, "none", 8);
+	else out[o] = '\0';
+	return out;
+}
+
+/* MTLTextureUsage as words */
+static const char *
+hm_ft_usage(unsigned long u, char out[48])
+{
+	out[0] = '\0';
+	if (u & MTLTextureUsageShaderRead) strlcat(out, "|read", 48);
+	if (u & MTLTextureUsageShaderWrite) strlcat(out, "|write", 48);
+	if (u & MTLTextureUsageRenderTarget) strlcat(out, "|rt", 48);
+	if (u & MTLTextureUsagePixelFormatView) strlcat(out, "|pfv", 48);
+	return out[0] != '\0' ? out + 1 : "none";
+}
+
+/* N bytes of record lines appended (LOCK held); a line that finds no memory is dropped */
+static void
+hm_ft_put(struct hm_ft_rec *ft, const char *s, size_t n)
+{
+	if (ft->len + n + 1 > ft->cap) {
+		const size_t cap = MAX(2 * ft->cap, ft->len + n + 1);
+		char *grown = realloc(ft->buf, cap);
+
+		if (grown == NULL) return;
+		ft->buf = grown;
+		ft->cap = cap;
+	}
+	memcpy(ft->buf + ft->len, s, n);
+	ft->len += n;
+}
+
+static void hm_ft_line(struct hm_ft_rec *ft, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+
+/* one record line, whole, into FT */
+static void
+hm_ft_line(struct hm_ft_rec *ft, const char *fmt, ...)
+{
+	char small[2048], *line = small;
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(small, sizeof(small), fmt, ap);
+	va_end(ap);
+	if (n < 0) return;
+	if ((size_t)n >= sizeof(small)) {
+		va_start(ap, fmt);
+		n = vasprintf(&line, fmt, ap);
+		va_end(ap);
+		if (n < 0) return;
+	}
+	pthread_mutex_lock(&ft->lock);
+	hm_ft_put(ft, line, (size_t)n);
+	pthread_mutex_unlock(&ft->lock);
+	if (line != small) free(line);
+}
+
+/* YES the first time ID (a texture's, a sampler's or a pipeline's) is named in FT: its describing line is due */
+static BOOL
+hm_ft_first(struct hm_ft_rec *ft, uint64_t id)
+{
+	BOOL first;
+
+	pthread_mutex_lock(&ft->lock);
+	first = ![ft->named containsIndex:(NSUInteger)id];
+	if (first) [ft->named addIndex:(NSUInteger)id];
+	pthread_mutex_unlock(&ft->lock);
+	return first;
+}
+
+/* the next number of a counter of FT's (encoders, draws, ops) */
+static unsigned
+hm_ft_next(struct hm_ft_rec *ft, unsigned *counter)
+{
+	unsigned n;
+
+	pthread_mutex_lock(&ft->lock);
+	n = (*counter)++;
+	pthread_mutex_unlock(&ft->lock);
+	return n;
+}
+
+/* the passes the core has opened in CB so far, each kind (hakios_metal_cb_counts): a draw's, blit's or dispatch's own
+ * pass is the last of them once it is recorded, which is its index among the passes the core times (gpass), less those
+ * of sub-encoders, which it does not */
+static unsigned
+hm_ft_total(hakios_metal_cb *cb)
+{
+	unsigned passes = 0, draws = 0, dispatches = 0, copies = 0, clears = 0;
+
+	hakios_metal_cb_counts(cb, &passes, &draws, &dispatches, &copies, &clears);
+	return passes + dispatches + copies + clears;
+}
+
+/* the core's pass index of what was just recorded on CB, which had BEFORE passes before it, and how many it opened */
+static int
+hm_ft_core(struct hm_ft_rec *ft, hakios_metal_cb *cb, unsigned before, unsigned *opened)
+{
+	const unsigned after = hm_ft_total(cb);
+
+	*opened = after > before ? after - before : 0;
+	return after == 0 || after - 1 < ft->unprofiled ? -1 : (int)(after - 1 - ft->unprofiled);
+}
+
+/* --- captures --- */
+
+static dispatch_queue_t
+hm_ft_writer(void)
+{
+	static dispatch_queue_t queue;
+	static dispatch_once_t once;
+
+	dispatch_once(&once, ^{
+		queue = dispatch_queue_create("hakios.metal.frame-trace", DISPATCH_QUEUE_SERIAL);
+	});
+	return queue;
+}
+
+static void
+hm_ft_write_all(int fd, const char *p, size_t n)
+{
+	while (n > 0) {
+		const ssize_t w = write(fd, p, n);
+
+		if (w <= 0) return;
+		p += w;
+		n -= (size_t)w;
+	}
+}
+
+/* a capture whose every command buffer is written: its last line, the console told, and it gone */
+static void
+hm_ft_capture_done(struct hm_ft_capture *c)
+{
+	char line[160];
+	const int n = snprintf(line, sizeof(line), "endtrace capture=%u cbs=%u bytes=%zu\n", c->number, c->written, c->bytes);
+	const int fd = open(c->path, O_WRONLY | O_APPEND);
+
+	if (fd >= 0) {
+		hm_ft_write_all(fd, line, (size_t)n);
+		close(fd);
+	}
+	hm_print("frame trace: capture %u done: %u command buffers, %zu KB in %s\n", c->number, c->written, c->bytes >> 10, c->path);
+	free(c);
+}
+
+/* RECORD (malloc'd, LEN bytes) appended to C's file by the writer's queue, which frees it */
+static void
+hm_ft_write(struct hm_ft_capture *c, char *record, size_t len)
+{
+	dispatch_async(hm_ft_writer(), ^{
+		const int fd = open(c->path, O_WRONLY | O_APPEND);
+		BOOL done;
+
+		if (fd >= 0) {
+			hm_ft_write_all(fd, record, len);
+			close(fd);
+		}
+		free(record);
+		pthread_mutex_lock(&hm_ft.lock);
+		c->written++;
+		c->bytes += len;
+		done = c->closed && c->written == c->taken;
+		if (done && hm_ft.capture == c) hm_ft.capture = NULL;
+		pthread_mutex_unlock(&hm_ft.lock);
+		if (done) hm_ft_capture_done(c);
+	});
+}
+
+/* a capture armed for K command buffers (WHY: file or every): its file begun with the trace line; the one before it,
+ * if it was still taking, takes no more */
+static void
+hm_ft_arm(unsigned k, const char *why)
+{
+	struct hm_ft_capture *c, *finished = NULL;
+	char args[1024] = "", quoted[1100], line[1400];
+	size_t size = sizeof(args) - 1;
+	int fd, n;
+
+	if (strcmp(why, "every") == 0 && __atomic_load_n(&hm_ft.armed, __ATOMIC_ACQUIRE) > 0) {
+		return;   /* (the clock does not cut a capture short) */
+	}
+	if ((c = calloc(1, sizeof(*c))) == NULL) return;
+	(void)hm_bootargs(args, &size);
+	/* (the file begun before the capture is installed: no command buffer waits on the flash for it) */
+	c->number = __atomic_add_fetch(&hm_ft.captures, 1, __ATOMIC_ACQ_REL);
+	snprintf(c->path, sizeof(c->path), "%s/metal-trace-%d-%u.txt", hm_ft_dir, getpid(), c->number);
+	fd = open(c->path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (fd < 0) {
+		hm_print("frame trace: capture %u not taken: %s: %s\n", c->number, c->path, strerror(errno));
+		free(c);
+		return;
+	}
+	n = snprintf(line, sizeof(line), "# hakios-metal frame trace (metal_trace=frame); read by trace-frame.py\n"
+		     "trace fmt=1 proc=%s pid=%d capture=%u cbs=%u why=%s t=%.6f wall=%ld args=%s\n", getprogname(), getpid(), c->number, k,
+		     why, hm_now(), (long)time(NULL), hm_ft_q(quoted, sizeof(quoted), args));
+	hm_ft_write_all(fd, line, (size_t)MIN(n, (int)sizeof(line) - 1));
+	close(fd);
+	pthread_mutex_lock(&hm_ft.lock);
+	if (hm_ft.capture != NULL && !hm_ft.capture->closed) {
+		hm_ft.capture->closed = YES;
+		if (hm_ft.capture->written == hm_ft.capture->taken) finished = hm_ft.capture;
+	}
+	hm_ft.capture = c;
+	hm_ft.armed = (int)k;
+	pthread_mutex_unlock(&hm_ft.lock);
+	if (finished != NULL) {
+		/* (nothing of it left in flight: its last line goes after the writer's queue has written what it holds) */
+		dispatch_async(hm_ft_writer(), ^{
+			hm_ft_capture_done(finished);
+		});
+	}
+	hm_print("frame trace: capture %u (%s): the next %u command buffers, into %s\n", c->number, why, k, c->path);
+}
+
+/* the watcher: the trigger file every 100 ms, the clock's captures; it runs for the process's life */
+static void *
+hm_ft_watch(void *unused)
+{
+	struct stat st;
+	ino_t ino = 0;
+	struct timespec seen = { 0, 0 };
+	double last = hm_now();
+
+	(void)unused;
+	pthread_setname_np("hakios.metal.frame-trace");
+	/* (a trigger left from before this process does not fire: only one touched while it runs) */
+	if (stat(HM_FT_TRIGGER, &st) == 0) {
+		ino = st.st_ino;
+		seen = st.st_mtimespec;
+	}
+	for (;;) {
+		usleep(100000);
+		if (stat(HM_FT_TRIGGER, &st) == 0 &&
+		    (st.st_ino != ino || st.st_mtimespec.tv_sec != seen.tv_sec || st.st_mtimespec.tv_nsec != seen.tv_nsec)) {
+			char words[256] = "";
+			unsigned k = hm_ft_cbs;
+			BOOL mine = YES;
+			const int fd = open(HM_FT_TRIGGER, O_RDONLY);
+
+			ino = st.st_ino;
+			seen = st.st_mtimespec;
+			if (fd >= 0) {
+				const ssize_t got = read(fd, words, sizeof(words) - 1);
+
+				words[got > 0 ? got : 0] = '\0';
+				close(fd);
+			}
+			char *rest = NULL;
+
+			for (char *w = strtok_r(words, " \t\r\n", &rest); w != NULL; w = strtok_r(NULL, " \t\r\n", &rest)) {
+				if (strspn(w, "0123456789") == strlen(w) && atoi(w) > 0) k = (unsigned)MIN(atoi(w), 1000);
+				else if (strncmp(w, "proc=", 5) == 0) mine = strcmp(w + 5, getprogname()) == 0;
+			}
+			if (mine) hm_ft_arm(k, "file");
+		}
+		if (hm_ft_every > 0 && hm_now() - last >= hm_ft_every) {
+			last = hm_now();
+			hm_ft_arm(hm_ft_cbs, "every");
+		}
+	}
+	return NULL;
+}
+
+/* At a command buffer's making (CREATED): a recorder when a capture wants it, else NULL -- one atomic load when none does */
+static struct hm_ft_rec *
+hm_ft_take(double created)
+{
+	struct hm_ft_rec *ft;
+	struct hm_ft_capture *c = NULL;
+
+	if (__atomic_load_n(&hm_ft.armed, __ATOMIC_ACQUIRE) <= 0 || (ft = calloc(1, sizeof(*ft))) == NULL) {
+		return NULL;
+	}
+	pthread_mutex_lock(&hm_ft.lock);
+	if (hm_ft.armed > 0 && hm_ft.capture != NULL) {
+		c = hm_ft.capture;
+		hm_ft.armed--;
+		ft->seq = ++c->taken;
+		ft->serial = ++hm_ft.serial;
+		if (hm_ft.armed == 0) c->closed = YES;
+	}
+	pthread_mutex_unlock(&hm_ft.lock);
+	if (c == NULL) {
+		free(ft);
+		return NULL;
+	}
+	pthread_mutex_init(&ft->lock, NULL);
+	ft->capture = c;
+	ft->created = created;
+	ft->cap = 64 * 1024;
+	ft->buf = malloc(ft->cap);
+	if (ft->buf == NULL) ft->cap = 0;
+	ft->named = [[NSMutableIndexSet alloc] init];
+	return ft;
+}
+
+/* the gpass lines of a command buffer the GPU is done with (or never had): the core's passes as it timed them */
+static void
+hm_ft_gpasses(struct hm_ft_rec *ft, hakios_metal_cb *cb)
+{
+	const int n = hakios_metal_cb_pass_time(cb, 0, NULL, NULL, NULL, NULL, NULL);
+
+	for (int i = 0; i < n; i++) {
+		unsigned kind = 0, width = 0, height = 0, draws = 0, attached = 0, touched = 0;
+		double us = 0;
+		char why[300];
+		int tiles;
+
+		if (hakios_metal_cb_pass_time(cb, (unsigned)i, &kind, &width, &height, &draws, &us) < 0) break;
+		tiles = hakios_metal_cb_pass_tiles(cb, (unsigned)i);
+		(void)hakios_metal_cb_pass_attachments(cb, (unsigned)i, &attached, &touched);
+		hm_ft_line(ft, "gpass i=%d kind=%s w=%u h=%u draws=%u us=%.1f mode=%s tiles=%d attached=0x%x touched=0x%x why=%s\n", i,
+			   HM_FT_NAME(kind, "draw", "copy", "clear", "dispatch"), width, height, draws, us,
+			   kind != 0 ? "-" : tiles > 0 ? "gmem" : "sysmem", MAX(tiles, 0), attached, touched,
+			   hm_ft_q(why, sizeof(why), hakios_metal_cb_pass_sysmem_why(cb, (unsigned)i)));
+	}
+}
+
+/* --- what a draw's vertices cover --- */
+
+/*
+ * The pixels a draw's vertices land on (BOX: x0 y0 x1 y1, not clipped), from a convention every vertex function of
+ * CoreAnimation's keeps (QuartzCore's default.metallib of 20H392, its AIR read on the host): its mvp_matrix, a
+ * float4x4, at [[buffer(2)]]. Each position times it, divided by w, through the viewport. The positions are attribute
+ * 0 of the pipeline's vertex descriptor -- "position", a float4, in every one of its functions that has one (std_vert*,
+ * fixed_vert_*_spc, the blur passes' downsample/upsample) -- or, for fixed_vert_*_gen, which reads its vertices itself,
+ * the records at [[buffer(1)]] laid out as byte 2 of [[buffer(0)]] says (VertexShaderConfig.layout: 0 a 48-byte
+ * SurfaceVertex, float4 first; 1 a LineVertex, float2 first, 12 bytes with fc_base_color and 16 without; 2 a 16-byte
+ * PointVertex, float2 first). NO when any of it is not there or a w is not positive; at most 4096 vertices are read
+ * (*READ of them), the first six positions into POS.
+ */
+static BOOL
+hm_ft_geometry(const struct hm_ft_pipe *p, hakios_metal_buffer *const *vs, const uint64_t *vsOffsets, unsigned vsCount,
+	       const struct hakios_metal_viewport *vp, unsigned start, unsigned count, hakios_metal_buffer *index, unsigned indexType,
+	       uint64_t indexOffset, long baseVertex, float box[4], float pos[12], unsigned *positions, unsigned *read, const char **source)
+{
+	const uint8_t *vertices, *indices = NULL;
+	uint64_t length, indexLength = 0, base;
+	unsigned stride, offset = 0, components, half = 0;
+	float m[16];
+
+	*positions = *read = 0;
+	if (p == NULL || vsCount <= 2 || vs[2] == NULL) return NO;
+	{
+		const uint8_t *mvp = hakios_metal_buffer_contents(vs[2]);
+		const uint64_t ml = hakios_metal_buffer_length(vs[2]);
+
+		if (mvp == NULL || vsOffsets[2] > ml || ml - vsOffsets[2] < 64) return NO;
+		memcpy(m, mvp + vsOffsets[2], 64);
+	}
+	if (p->vdFormat != 0) {
+		switch (p->vdFormat) {
+		case MTLVertexFormatHalf2: components = 2; half = 1; break;
+		case MTLVertexFormatHalf4: components = 4; half = 1; break;
+		case MTLVertexFormatFloat2: components = 2; break;
+		case MTLVertexFormatFloat3: components = 3; break;
+		case MTLVertexFormatFloat4: components = 4; break;
+		default: return NO;
+		}
+		if (p->vdBuffer >= vsCount || vs[p->vdBuffer] == NULL) return NO;
+		vertices = hakios_metal_buffer_contents(vs[p->vdBuffer]);
+		length = hakios_metal_buffer_length(vs[p->vdBuffer]);
+		base = vsOffsets[p->vdBuffer];
+		stride = p->vdStride;
+		offset = p->vdOffset;
+		*source = "vd";
+	} else if (p->fixedVert) {
+		const uint8_t *config;
+		uint64_t cl;
+
+		if (vsCount <= 1 || vs[0] == NULL || vs[1] == NULL || (config = hakios_metal_buffer_contents(vs[0])) == NULL) return NO;
+		cl = hakios_metal_buffer_length(vs[0]);
+		if (vsOffsets[0] > cl || cl - vsOffsets[0] < 4) return NO;
+		switch (config[vsOffsets[0] + 2]) {
+		case 0: stride = 48; components = 4; break;
+		case 1: stride = p->baseColor ? 12 : 16; components = 2; break;
+		case 2: stride = 16; components = 2; break;
+		default: return NO;
+		}
+		vertices = hakios_metal_buffer_contents(vs[1]);
+		length = hakios_metal_buffer_length(vs[1]);
+		base = vsOffsets[1];
+		*source = "cfg";
+	} else {
+		return NO;
+	}
+	if (vertices == NULL || stride == 0 || stride > 4096) return NO;
+	if (index != NULL && (indices = hakios_metal_buffer_contents(index)) == NULL) return NO;
+	if (index != NULL) indexLength = hakios_metal_buffer_length(index);
+	box[0] = box[1] = INFINITY;
+	box[2] = box[3] = -INFINITY;
+	for (unsigned i = 0; i < count && *read < 4096; i++) {
+		const unsigned bytes = components * (half ? 2u : 4u);
+		float c[4] = { 0, 0, 0, 1 };
+		uint64_t v, at;
+
+		if (indices != NULL) {
+			const unsigned size = indexType == MTLIndexTypeUInt32 ? 4 : 2;
+			uint32_t x = 0;
+
+			at = indexOffset + (uint64_t)i * size;
+			if (at + size > indexLength) return NO;
+			memcpy(&x, indices + at, size);
+			if (x == (size == 4 ? 0xffffffffu : 0xffffu)) continue;   /* primitive restart */
+			if ((long)x + baseVertex < 0) return NO;
+			v = (uint64_t)((long)x + baseVertex);
+		} else {
+			v = (uint64_t)start + i;
+		}
+		at = base + v * stride + offset;
+		if (at < base || at + bytes > length) return NO;
+		for (unsigned k = 0; k < components; k++) {
+			if (half) {
+				__fp16 h;
+
+				memcpy(&h, vertices + at + 2 * k, 2);
+				c[k] = (float)h;
+			} else {
+				memcpy(&c[k], vertices + at + 4 * k, 4);
+			}
+		}
+		{
+			const float cx = m[0] * c[0] + m[4] * c[1] + m[8] * c[2] + m[12] * c[3];
+			const float cy = m[1] * c[0] + m[5] * c[1] + m[9] * c[2] + m[13] * c[3];
+			const float cw = m[3] * c[0] + m[7] * c[1] + m[11] * c[2] + m[15] * c[3];
+			float x, y;
+
+			if (!(cw > 0)) return NO;
+			x = (float)(vp->x + (cx / cw + 1) * 0.5 * vp->width);
+			y = (float)(vp->y + (1 - cy / cw) * 0.5 * vp->height);
+			if (!isfinite(x) || !isfinite(y)) return NO;
+			box[0] = MIN(box[0], x);
+			box[1] = MIN(box[1], y);
+			box[2] = MAX(box[2], x);
+			box[3] = MAX(box[3], y);
+			if (*positions < 6) {
+				pos[2 * *positions] = x;
+				pos[2 * *positions + 1] = y;
+				(*positions)++;
+			}
+			(*read)++;
+		}
+	}
+	return *read > 0;
+}
