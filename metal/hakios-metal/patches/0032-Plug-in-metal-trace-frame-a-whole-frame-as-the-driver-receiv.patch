+/* --- a render pipeline's description --- */
+
+/* a function's constants: the ones not 0 as "index=value ...", and a key over all of them */
+static uint32_t
+hm_ft_constants(const hakios_metal_constant *c, unsigned count, char *out, size_t size)
+{
+	uint32_t key = 2166136261u;
+	size_t at = 0;
+
+	out[0] = '\0';
+	for (unsigned i = 0; i < count; i++) {
+		key = hm_ft_fnv(&c[i].index, sizeof(c[i].index), key);
+		key = hm_ft_fnv(&c[i].bits, sizeof(c[i].bits), key);
+		if (c[i].bits != 0) hm_ft_cat(out, size, &at, "%s%u=%llu", at != 0 ? " " : "", c[i].index, (unsigned long long)c[i].bits);
+	}
+	return key;
+}
+
+/* the value CONSTANTS give the function constant NAME of FUNCTION, -1 when it declares none of that name or none was given */
+static long long
+hm_ft_constant_named(id function, NSString *name, const hakios_metal_constant *constants, unsigned count)
+{
+	MTLFunctionConstant *c = function != nil && [function respondsToSelector:@selector(functionConstantsDictionary)] ?
+		[[function functionConstantsDictionary] objectForKey:name] : nil;
+
+	for (unsigned i = 0; c != nil && i < count; i++) {
+		if (constants[i].index == (unsigned)[c index]) return (long long)constants[i].bits;
+	}
+	return -1;
+}
