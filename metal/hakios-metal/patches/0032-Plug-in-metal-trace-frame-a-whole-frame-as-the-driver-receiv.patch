+/* the size of the attachment a pass draws into: colour 0's level, or the first other colour attachment's, or depth's */
+static void
+hm_ft_window(const struct hakios_metal_render_pass *pass, unsigned *w, unsigned *h)
+{
+	hakios_metal_texture *t = pass->color0;
+	unsigned level = pass->color0_level;
+
+	for (unsigned i = 0; t == NULL && i < 7; i++) {
+		t = pass->more[i].texture;
+		level = pass->more[i].level;
+	}
+	if (t == NULL) {
+		t = pass->depth;
+		level = pass->depth_level;
+	}
+	*w = t != NULL ? MAX(hakios_metal_texture_width(t) >> level, 1u) : 0;
+	*h = t != NULL ? MAX(hakios_metal_texture_height(t) >> level, 1u) : 0;
+}
+
+/* --- a render pass's attachments, as the descriptor gives them --- */
+
+static void
+hm_ft_attachment(struct hm_ft_rec *ft, unsigned enc, const char *slot, MTLRenderPassAttachmentDescriptor *a, const char *clear)
+{
+	id t = [a texture];
+	char resolve[48] = "";
+
+	if (t == nil || ![t isKindOfClass:[HakiosMetalTexture class]]) {
+		if (t != nil) hm_ft_line(ft, "att enc=%u slot=%s foreign=%s\n", enc, slot, class_getName(object_getClass(t)));
+		return;
+	}
+	if ([a resolveTexture] != nil && [[a resolveTexture] isKindOfClass:[HakiosMetalTexture class]]) {
+		snprintf(resolve, sizeof(resolve), " resolve=%llu", (unsigned long long)[(HakiosMetalTexture *)[a resolveTexture] hakiosFtName:ft]);
+	}
+	hm_ft_line(ft, "att enc=%u slot=%s tex=%llu lvl=%lu slice=%lu plane=%lu load=%s store=%s %s%s\n", enc, slot,
+		   (unsigned long long)[(HakiosMetalTexture *)t hakiosFtName:ft], (unsigned long)[a level], (unsigned long)[a slice],
+		   (unsigned long)[a depthPlane], HM_FT_LOAD([a loadAction]), HM_FT_STORE([a storeAction]), clear, resolve);
+}
+
+/* the enc line of a render (or parallel) encoder and an att line for each attachment of D */
+static void
+hm_ft_pass(struct hm_ft_rec *ft, unsigned enc, const char *kind, MTLRenderPassDescriptor *d)
+{
+	char clear[96];
+
+	hm_ft_line(ft, "enc i=%u kind=%s t=%.6f rt=%lux%lu\n", enc, kind, hm_now(), (unsigned long)[d renderTargetWidth],
+		   (unsigned long)[d renderTargetHeight]);
+	for (NSUInteger i = 0; i < 8; i++) {
+		MTLRenderPassColorAttachmentDescriptor *c = [[d colorAttachments] objectAtIndexedSubscript:i];
+		MTLClearColor cc = [c clearColor];
+		char slot[8];
+
+		snprintf(slot, sizeof(slot), "c%lu", (unsigned long)i);
+		snprintf(clear, sizeof(clear), "clear=%g,%g,%g,%g", cc.red, cc.green, cc.blue, cc.alpha);
+		if (c != nil) hm_ft_attachment(ft, enc, slot, c, clear);
+	}
+	snprintf(clear, sizeof(clear), "clear=%g", [[d depthAttachment] clearDepth]);
+	hm_ft_attachment(ft, enc, "depth", [d depthAttachment], clear);
+	snprintf(clear, sizeof(clear), "clear=%u", [[d stencilAttachment] clearStencil]);
+	hm_ft_attachment(ft, enc, "stencil", [d stencilAttachment], clear);
+	if ([d visibilityResultBuffer] != nil) hm_ft_line(ft, "att enc=%u slot=visibility\n", enc);
+}
+
+/* the dbuf lines of one stage's buffer table (D the draw or dispatch, KEY "d" or "op"), each with its first 64 bytes */
+static void
+hm_ft_buffers(struct hm_ft_rec *ft, const char *key, unsigned d, const char *stage, HakiosMetalBuffer *const *table, const uint64_t *offsets,
+	      unsigned count, uint32_t used, BOOL known)
+{
+	for (unsigned i = 0; i < count; i++) {
+		hakios_metal_buffer *b = table[i] != nil ? [table[i] hakiosBuffer] : NULL;
+		const uint8_t *bytes = b != NULL ? hakios_metal_buffer_contents(b) : NULL;
+		const uint64_t length = b != NULL ? hakios_metal_buffer_length(b) : 0;
+		char hex[2 * 64 + 1] = "";
+
+		if (b == NULL) continue;
+		if (bytes != NULL && offsets[i] < length) hm_ft_hex(hex, bytes + offsets[i], (size_t)MIN(length - offsets[i], 64));
+		hm_ft_line(ft, "dbuf %s=%u stage=%s slot=%u buf=0x%llx len=%llu off=%llu used=%s hex=%s\n", key, d, stage, i,
+			   (unsigned long long)hakios_metal_buffer_gpu_address(b), (unsigned long long)length, (unsigned long long)offsets[i],
+			   !known ? "?" : (used >> i) & 1 ? "1" : "0", hex[0] != '\0' ? hex : "-");
+	}
+}
+
+/* the resources STAGE of PROGRAM declares, as masks: textures and images by index (two words), samplers, buffers */
+static BOOL
+hm_ft_used(hakios_metal_program *program, unsigned stage, uint64_t textures[2], uint32_t *samplers, uint32_t *buffers)
+{
+	const unsigned n = program != NULL ? hakios_metal_program_resource_count(program, stage) : 0;
+
+	textures[0] = textures[1] = 0;
+	*samplers = *buffers = 0;
+	if (program == NULL) return NO;
+	for (unsigned i = 0; i < n; i++) {
+		unsigned kind = 0, index = 0, size = 0;
+
+		if (hakios_metal_program_resource(program, stage, i, &kind, &index, &size) != 0) continue;
+		if ((kind == HAKIOS_METAL_RESOURCE_TEXTURE || kind == HAKIOS_METAL_RESOURCE_IMAGE) && index < 128) textures[index / 64] |= 1ull << (index % 64);
+		else if (kind == HAKIOS_METAL_RESOURCE_SAMPLER && index < 32) *samplers |= 1u << index;
+		else if ((kind == HAKIOS_METAL_RESOURCE_CONSTANT_BUFFER || kind == HAKIOS_METAL_RESOURCE_DEVICE_BUFFER) && index < 32) *buffers |= 1u << index;
+	}
+	return YES;
+}
+
+/* the dtex and dsamp lines of one stage's tables: a texture with the sampler at its own index, a sampler with no
+ * texture beside it on its own */
+static void
+hm_ft_textures(struct hm_ft_rec *ft, const char *key, unsigned d, const char *stage, HakiosMetalTexture *const *textures, unsigned textureCount,
+	       HakiosMetalSamplerState *const *samplers, unsigned samplerCount, const uint64_t used[2], uint32_t usedSamplers, BOOL known)
+{
+	for (unsigned i = 0; i < textureCount; i++) {
+		char samp[40] = "";
+
+		if (textures[i] == nil) continue;
+		if (i < samplerCount && samplers[i] != nil) snprintf(samp, sizeof(samp), " samp=%llu", (unsigned long long)[samplers[i] hakiosFtName:ft]);
+		hm_ft_line(ft, "dtex %s=%u stage=%s slot=%u tex=%llu used=%s%s\n", key, d, stage, i, (unsigned long long)[textures[i] hakiosFtName:ft],
+			   !known ? "?" : (used[i / 64] >> (i % 64)) & 1 ? "1" : "0", samp);
+	}
+	for (unsigned i = 0; i < samplerCount; i++) {
+		if (samplers[i] == nil || (i < textureCount && textures[i] != nil)) continue;
+		hm_ft_line(ft, "dsamp %s=%u stage=%s slot=%u samp=%llu used=%s\n", key, d, stage, i, (unsigned long long)[samplers[i] hakiosFtName:ft],
+			   !known ? "?" : (usedSamplers >> i) & 1 ? "1" : "0");
+	}
+}
