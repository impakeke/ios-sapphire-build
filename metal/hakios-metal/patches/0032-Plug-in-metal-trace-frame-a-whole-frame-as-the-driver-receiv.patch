index 15e2e94..17ad152 100644
--- a/hakios-metal/src/c_api.cpp
+++ b/hakios-metal/src/c_api.cpp
@@ -1258,6 +1258,18 @@ unsigned hakios_metal_program_stage_words(hakios_metal_program* p, unsigned stag
     return (stage == 0 ? p->program->program.vs : p->program->program.fs).k.numWords;
 }
 
+unsigned hakios_metal_program_fs_traits(hakios_metal_program* p) {
+    if (p == nullptr) return 0;
+    const Stage& fs = p->program->program.fs;
+    unsigned bits = 0;
+    for (uint32_t i = 0; i < kMaxTextureSlots && i < fs.k.numTextureSlots; i++) {
+        const uint8_t target = fs.k.textures[i].fbTarget;   // n + 1 where the slot reads [[color(n)]]
+        if (target != 0 && target <= kMaxColorOutputs) bits |= 1u << (target - 1u);
+    }
+    if (fs.hasKill) bits |= 1u << 8;
+    return bits;
+}
