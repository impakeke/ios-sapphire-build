+/* --- debug groups --- */
+
+/*
+ * An encoder's or a command buffer's debug groups and signposts (the names a client gives what it draws, when it gives
+ * any) into the record, then on to the base class's own method, which answers as it always did. Added at run time,
+ * only while the switch is on and only where the base class has the method, so that with the switch off -- or in a
+ * Metal whose base classes have no such method -- nothing about these messages changes.
+ */
+static void
+hm_ft_debug_methods(void)
+{
+	Class classes[4] = { [HakiosMetalRenderCommandEncoder class], [HakiosMetalBlitCommandEncoder class], [HakiosMetalComputeCommandEncoder class],
+			     [HakiosMetalCommandBuffer class] };
+
+	for (int k = 0; k < 4; k++) {
+		const Class c = classes[k], base = class_getSuperclass(c);
+		SEL push = @selector(pushDebugGroup:), pop = @selector(popDebugGroup), sign = @selector(insertDebugSignpost:);
+		Method m;
+
+		if ((m = class_getInstanceMethod(base, push)) != NULL && class_getInstanceMethod(c, push) == m) {
+			void (*original)(id, SEL, NSString *) = (void (*)(id, SEL, NSString *))method_getImplementation(m);
+
+			class_addMethod(c, push, imp_implementationWithBlock(^(id self, NSString *s) {
+				[self hakiosFtDebug:"push" string:s];
+				original(self, push, s);
+			}), method_getTypeEncoding(m));
+		}
+		if ((m = class_getInstanceMethod(base, sign)) != NULL && class_getInstanceMethod(c, sign) == m) {
+			void (*original)(id, SEL, NSString *) = (void (*)(id, SEL, NSString *))method_getImplementation(m);
+
+			class_addMethod(c, sign, imp_implementationWithBlock(^(id self, NSString *s) {
+				[self hakiosFtDebug:"signpost" string:s];
+				original(self, sign, s);
+			}), method_getTypeEncoding(m));
+		}
+		if ((m = class_getInstanceMethod(base, pop)) != NULL && class_getInstanceMethod(c, pop) == m) {
+			void (*original)(id, SEL) = (void (*)(id, SEL))method_getImplementation(m);
+
+			class_addMethod(c, pop, imp_implementationWithBlock(^(id self) {
+				[self hakiosFtDebug:"pop" string:nil];
+				original(self, pop);
+			}), method_getTypeEncoding(m));
+		}
+	}
+}
