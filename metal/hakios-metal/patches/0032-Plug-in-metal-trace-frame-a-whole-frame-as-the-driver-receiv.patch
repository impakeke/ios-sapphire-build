+/* --- one blit's line, whatever way the method that makes it returns --- */
+
+/*
+ * A blit method declares HM_FT_BLIT(cb) first and, when FTB.FT is set, says in FTB.WHAT what it copies; the line is
+ * written as the method returns, by way it returns, with the core passes the copy made and what became of it (the
+ * buffer's refusal count or error moving: the plug-in's own refusals go the same road as the core's).
+ */
+struct hm_ft_blit {
+	struct hm_ft_rec *ft;
+	hakios_metal_cb *cb;
+	unsigned enc, before, skipped;
+	BOOL failed;
+	char what[700];
+};
+
+static void
+hm_ft_blit_end(struct hm_ft_blit *b)
+{
+	const char *last = NULL;
+	char q[300];
+	unsigned opened;
+	int core;
+
+	if (b->ft == NULL) return;
+	core = hm_ft_core(b->ft, b->cb, b->before, &opened);
+	if (hakios_metal_cb_skipped(b->cb, &last) != b->skipped) {
+		snprintf(q, sizeof(q), "skipped: %s", last != NULL ? last : "");
+	} else if (!b->failed && hakios_metal_cb_error(b->cb)[0] != '\0') {
+		snprintf(q, sizeof(q), "failed: %s", hakios_metal_cb_error(b->cb));
+	} else {
+		strlcpy(q, "ok", sizeof(q));
+	}
+	{
+		char quoted[320];
+
+		hm_ft_line(b->ft, "blit i=%u enc=%u %s core=%d n=%u res=%s\n", hm_ft_next(b->ft, &b->ft->ops), b->enc, b->what,
+			   opened != 0 ? core - (int)opened + 1 : -1, opened, hm_ft_q(quoted, sizeof(quoted), q));
+	}
+}
+
+#define HM_FT_BLIT(cbexpr)								\
+	struct hm_ft_blit ftb __attribute__((cleanup(hm_ft_blit_end)));		\
+	ftb.ft = _ftrace;								\
+	if (ftb.ft != NULL) {								\
+		const char *ftbLast_ = NULL;						\
+		ftb.cb = (cbexpr);							\
+		ftb.enc = _ftEnc;							\
+		ftb.before = hm_ft_total(ftb.cb);					\
+		ftb.skipped = hakios_metal_cb_skipped(ftb.cb, &ftbLast_);		\
+		ftb.failed = hakios_metal_cb_error(ftb.cb)[0] != '\0';			\
+		strlcpy(ftb.what, "op=?", sizeof(ftb.what));				\
+	}
