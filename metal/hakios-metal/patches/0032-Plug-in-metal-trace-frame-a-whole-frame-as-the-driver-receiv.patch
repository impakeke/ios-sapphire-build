+/*
+ * The description of a render pipeline that metal_trace=frame writes the first time a recorded command buffer draws
+ * with it, made with the pipeline: its pipe line -- the functions, their labels (CoreAnimation's names for its variants),
+ * the constants each was specialised with and a key over them, where each stage's code came from (VS_FROM, FS_FROM:
+ * hm_bitcode_for's choice), the uber shader's deciding buffer, framebuffer fetch (the core's word when it has
+ * hakios_metal_program_fs_traits, else CoreAnimation's fc_framebuffer_fetch constant), how long the pipeline took to
+ * make -- and a pblend line for each colour attachment.
+ */
+static struct hm_ft_pipe *
+hm_ft_pipe_new(MTLRenderPipelineDescriptor *d, id vs, id fs, hakios_metal_program *program, const char *vsFrom, const char *fsFrom,
+	       const hakios_metal_constant *vsConstants, unsigned vsCount, const hakios_metal_constant *fsConstants, unsigned fsCount,
+	       uint64_t id, int specBinding, unsigned specLength, double began, double ended)
+{
+	struct hm_ft_pipe *p = calloc(1, sizeof(*p));
+	char *lines = NULL, vsfc[600], fsfc[600], q[10][400], fb[48], discard[8], vd[64] = "none", tmp[24], tmp2[24], tmp3[24];
+	MTLVertexAttributeDescriptor *a0 = [[[d vertexDescriptor] attributes] objectAtIndexedSubscript:0];
+	NSString *askedVs = vs != nil ? objc_getAssociatedObject(vs, &hm_ft_asked_key) : nil;
+	NSString *askedFs = fs != nil ? objc_getAssociatedObject(fs, &hm_ft_asked_key) : nil;
+	char vsWhere[300], fsWhere[300];
+	const uint32_t vsKey = hm_ft_constants(vsConstants, vsCount, vsfc, sizeof(vsfc));
+	const uint32_t fsKey = hm_ft_constants(fsConstants, fsCount, fsfc, sizeof(fsfc));
+	size_t at = 0, size = 8192;
+
+	if (p == NULL || (lines = malloc(size)) == NULL) {
+		free(p);
+		return NULL;
+	}
+	if (a0 != nil && [a0 format] != MTLVertexFormatInvalid) {
+		MTLVertexBufferLayoutDescriptor *l = [[[d vertexDescriptor] layouts] objectAtIndexedSubscript:[a0 bufferIndex]];
+
+		p->vdFormat = (unsigned)[a0 format];
+		p->vdOffset = (unsigned)[a0 offset];
+		p->vdBuffer = (unsigned)[a0 bufferIndex];
+		p->vdStride = l != nil ? (unsigned)[l stride] : 0;
+		snprintf(vd, sizeof(vd), "f%u+%u@b%u/%u", p->vdFormat, p->vdOffset, p->vdBuffer, p->vdStride);
+	}
+	p->fixedVert = [[vs name] hasPrefix:@"fixed_vert_"];
+	p->baseColor = hm_ft_constant_named(vs, @"fc_base_color", vsConstants, vsCount) > 0;
+	if (hm_ft_fs_traits != NULL) {
+		const unsigned traits = hm_ft_fs_traits(program);
+
+		snprintf(fb, sizeof(fb), "0x%x", traits & 0xff);
+		snprintf(discard, sizeof(discard), "%u", (traits >> 8) & 1);
+	} else {
+		const long long v = hm_ft_constant_named(fs, @"fc_framebuffer_fetch", fsConstants, fsCount);
+
+		snprintf(fb, sizeof(fb), v < 0 ? "?" : v ? "fc:1" : "fc:0");
+		strlcpy(discard, "?", sizeof(discard));
+	}
+	if (askedVs != nil) snprintf(vsWhere, sizeof(vsWhere), "asked:%s;%s", [askedVs UTF8String], vsFrom);
+	else strlcpy(vsWhere, vsFrom, sizeof(vsWhere));
+	if (askedFs != nil) snprintf(fsWhere, sizeof(fsWhere), "asked:%s;%s", [askedFs UTF8String], fsFrom);
+	else strlcpy(fsWhere, fsFrom, sizeof(fsWhere));
+	hm_ft_cat(lines, size, &at, "pipe id=%llu label=%s vs=%s fs=%s vs_label=%s fs_label=%s vs_from=%s fs_from=%s vs_fc=%s fs_fc=%s vs_key=%08x "
+		  "fs_key=%08x prog=%s vs_words=%u fs_words=%u spec_slot=%d spec_len=%u fbfetch=%s discard=%s samples=%lu depth=%s stencil=%s vd=%s "
+		  "created=%.6f compile_ms=%.3f\n", (unsigned long long)id, hm_ft_qs(q[0], sizeof(q[0]), [d label]),
+		  hm_ft_qs(q[1], sizeof(q[1]), [vs name]), hm_ft_qs(q[2], sizeof(q[2]), fs != nil ? [fs name] : nil),
+		  hm_ft_qs(q[3], sizeof(q[3]), [vs respondsToSelector:@selector(label)] ? [vs label] : nil),
+		  hm_ft_qs(q[4], sizeof(q[4]), [fs respondsToSelector:@selector(label)] ? [fs label] : nil), hm_ft_q(q[5], sizeof(q[5]), vsWhere),
+		  hm_ft_q(q[6], sizeof(q[6]), fsWhere), hm_ft_q(q[7], sizeof(q[7]), vsfc), hm_ft_q(q[8], sizeof(q[8]), fsfc), vsKey, fsKey,
+		  hm_ft_q(q[9], sizeof(q[9]), hakios_metal_program_name(program)), hakios_metal_program_stage_words(program, 0),
+		  hakios_metal_program_stage_words(program, 1), specBinding, specLength, fb, discard, (unsigned long)[d rasterSampleCount],
+		  hm_ft_format((unsigned)[d depthAttachmentPixelFormat], tmp, sizeof(tmp)),
+		  hm_ft_format((unsigned)[d stencilAttachmentPixelFormat], tmp2, sizeof(tmp2)), vd, began, (ended - began) * 1e3);
+	for (NSUInteger i = 0; i < 8; i++) {
+		MTLRenderPipelineColorAttachmentDescriptor *c = [[d colorAttachments] objectAtIndexedSubscript:i];
+		char mask[8];
+
+		if (c == nil || [c pixelFormat] == MTLPixelFormatInvalid) continue;
+		hm_ft_cat(lines, size, &at, "pblend pipe=%llu att=%lu fmt=%s on=%d rgb=%s alpha=%s src=%s dst=%s srca=%s dsta=%s mask=%s\n",
+			  (unsigned long long)id, (unsigned long)i, hm_ft_format((unsigned)[c pixelFormat], tmp3, sizeof(tmp3)), [c isBlendingEnabled] ? 1 : 0,
+			  HM_FT_BLENDOP([c rgbBlendOperation]), HM_FT_BLENDOP([c alphaBlendOperation]), HM_FT_FACTOR([c sourceRGBBlendFactor]),
+			  HM_FT_FACTOR([c destinationRGBBlendFactor]), HM_FT_FACTOR([c sourceAlphaBlendFactor]),
+			  HM_FT_FACTOR([c destinationAlphaBlendFactor]), hm_ft_mask((unsigned)[c writeMask], mask));
+	}
+	p->lines = lines;
+	return p;
+}
+
+static void
+hm_ft_pipe_free(struct hm_ft_pipe *p)
+{
+	if (p != NULL) free(p->lines);
+	free(p);
+}
