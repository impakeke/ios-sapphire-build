+/* a debug line of encoder ENC (-1: the command buffer's own) */
+static void
+hm_ft_debug(struct hm_ft_rec *ft, int enc, const char *what, NSString *string)
+{
+	char q[400];
+
+	if (ft != NULL) hm_ft_line(ft, "debug enc=%d op=%s text=%s\n", enc, what, hm_ft_qs(q, sizeof(q), string));
