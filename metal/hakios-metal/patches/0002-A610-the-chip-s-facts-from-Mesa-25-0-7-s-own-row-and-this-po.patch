Subject: A610: the chip's facts, from Mesa 25.0.7's own row and this port's kernel (-DHAKIOS_CHIP_A610)

The driver is written for one chip, the A635 of HackiOS's phone; its facts are constants in a6xx.hpp. With
HAKIOS_CHIP_A610 they are the Adreno 610's:

- the per-chip values Mesa generates for GPUId(610) (freedreno_devices.h __info6: a6xx_base + a6xx_gen1_low): thread
  sizes, instruction cache, fibers, SP cores, compute shared memory, the magic registers, no GMEM fast clear, one CCU
  with 8 KB caches, 16 visibility pipes, the tile grid;
- the chip id the kernel answers (0x06010001), which hakios_metal_open checks before anything else;
- the GMEM as this port's kernel programs it (0x100000, 0x21000 bytes: Linux's A610), the CCU's colour cache in its
  last 4 KB as turnip computes it, and RB_CCU_CNTL's cache size field from the fraction (HALF);
- a framebuffer fetch out of GMEM names the GMEM's GPU address (turnip: gmem_base + gmem_offset).

Tiled rendering is off unless the plug-in is given metal_gmem=1, so the GMEM values change nothing by default.

---
diff --git a/hakios-metal/include/hakios-metal/a6xx.hpp b/hakios-metal/include/hakios-metal/a6xx.hpp
index 8a73551..5afa602 100644
--- a/hakios-metal/include/hakios-metal/a6xx.hpp
+++ b/hakios-metal/include/hakios-metal/a6xx.hpp
@@ -27,6 +27,26 @@ namespace hakios::metal::a6xx {
 // From Mesa's src/freedreno/common/freedreno_devices.py: the entry for chip_id ...06030500 ("Adreno 7c+ Gen 3", every
 // speedbin of the A635) is a6xx_base + a6xx_gen4 with num_ccu = 2.
 
+#if defined(HAKIOS_CHIP_A610)
+// The Adreno 610 (sapphire: Redmi Note 13 4G, SM6225). Built with -DHAKIOS_CHIP_A610 (make ios CHIP=a610).
+// Every value is Mesa 25.0.7's row for this GPU -- the Mesa linked into this driver -- as its build generates it:
+// src/freedreno/common/freedreno_devices.h, { {610, 0x60100ff}, "FD610", &__info6 }, from freedreno_devices.py
+// (GPUId(610): a6xx_base + a6xx_gen1_low, lines 327-369 and 445-478).
+// The chip id is what this port's kernel answers for MSM_PARAM_CHIP_ID (xnu SapphireGpu.cpp msm_param: 0x06010001,
+// "a610 v2, read off the GPU"); Linux lists the family as ADRENO_CHIP_IDS(0x06010000) (a6xx_catalog.c). Mesa's row is
+// found by it without a GPU number: its 0x060100ff has the wildcard patch byte (freedreno_dev_info.c dev_id_compare,
+// rule b), so compiler.cpp and texture.cpp, which hand Mesa this chip id alone, get __info6.
+inline constexpr uint32_t kChipId = 0x06010001;              // xnu SapphireGpu.cpp msm_param CHIP_ID
+inline constexpr bool kHasLpac = false;                      // __info6 has no .has_lpac (a6xx_gen4 alone sets it)
+inline constexpr bool kSupportsDoubleThreadsize = false;     // __info6 .supports_double_threadsize=False (a6xx_gen1_low)
+inline constexpr uint32_t kInstrCacheSize = 64;              // __info6 .instr_cache_size=64 (a6xx_gen1_low)
+inline constexpr uint32_t kFibersPerSp = 128 * 16;           // __info6 .fibers_per_sp=2048
+inline constexpr uint32_t kNumSpCores = 1;                   // __info6 .num_sp_cores=1 (= num_ccu)
+inline constexpr uint32_t kCsSharedMemSize = 16 * 1024;      // __info6 .cs_shared_mem_size=16384
+inline constexpr uint32_t kThreadsizeBase = 64;              // __info6 .threadsize_base=64
+inline constexpr uint32_t kMaxWaves = 16;                    // __info6 .max_waves=16
+inline constexpr uint32_t kWaveGranularity = 1;              // __info6 .wave_granularity=1
+#else
 inline constexpr uint32_t kChipId = 0x06030500;             // not-in-headers: freedreno_devices.py GPUId(chip_id=0x..06030500)
 inline constexpr bool kHasLpac = true;                       // not-in-headers: freedreno_devices.py a6xx_gen4.has_lpac
 inline constexpr bool kSupportsDoubleThreadsize = true;      // not-in-headers: freedreno_devices.py a6xx_base.supports_double_threadsize
@@ -39,6 +59,7 @@ inline constexpr uint32_t kCsSharedMemSize = 32 * 1024;      // not-in-headers:
 inline constexpr uint32_t kThreadsizeBase = 64;              // not-in-headers: freedreno_devices.py A6xxGPUInfo default threadsize_base
 inline constexpr uint32_t kMaxWaves = 16;                    // not-in-headers: freedreno_devices.py A6xxGPUInfo default max_waves
 inline constexpr uint32_t kWaveGranularity = 2;              // not-in-headers: freedreno_devices.py, the A635 entry (wave_granularity)
+#endif
 // ir3's "no register": regid(63, 0) = 63 << 2 | 0. The *CONSTID / *REGID fields take it for a value the shader does
 // not read (the work group size and offset constants, the linear local id), and it is what Mesa writes there.
 inline constexpr uint32_t kRegidNone = 0xfc;                 // not-in-headers: ir3/instr-a3xx.h INVALID_REG = regid(63, 0)
@@ -1390,6 +1411,40 @@ struct RegWrite {
 
 // Mesa's per-chip "magic" values, as its generated freedreno_devices.h has them for this chip (__info14, the entry every
 // A635 chip id maps to). Mesa does not know what most of them mean either; they are what the blob writes.
+#if defined(HAKIOS_CHIP_A610)
+// Mesa 25.0.7 freedreno_devices.h __info6 .a6xx.magic (the A610 row's magic_regs, freedreno_devices.py:459-477)
+inline constexpr uint32_t kMagicPcPowerCntl = 0;                  // .PC_POWER_CNTL=0
+inline constexpr uint32_t kMagicTpl1DbgEcoCntl = 0;               // .TPL1_DBG_ECO_CNTL=0
+inline constexpr uint32_t kMagicGrasDbgEcoCntl = 0;               // .GRAS_DBG_ECO_CNTL=0
+inline constexpr uint32_t kMagicSpChickenBits = 0;                // .SP_CHICKEN_BITS=0
+inline constexpr uint32_t kMagicUcheClientPf = 0x00000004;        // .UCHE_CLIENT_PF=4
+inline constexpr uint32_t kMagicPcModeCntl = 0xf;                 // .PC_MODE_CNTL=15
+inline constexpr uint32_t kMagicSpDbgEcoCntl = 0;                 // .SP_DBG_ECO_CNTL=0
+inline constexpr uint32_t kMagicRbDbgEcoCntl = 0x04100000;        // .RB_DBG_ECO_CNTL=68157440 (and .RB_DBG_ECO_CNTL_blit the same)
+inline constexpr uint32_t kMagicHlsqDbgEcoCntl = 0;               // .HLSQ_DBG_ECO_CNTL=0
+inline constexpr uint32_t kMagicRbUnknown8E01 = 0x00000001;       // .RB_UNKNOWN_8E01=1
+inline constexpr uint32_t kMagicVpcDbgEcoCntl = 0;                // .VPC_DBG_ECO_CNTL=0
+inline constexpr uint32_t kMagicUcheUnknown0E12 = 0x10000000;     // .UCHE_UNKNOWN_0E12=268435456
+// and the chip facts fd6_emit_static_regs and fd6_emit_ccu_cntl branch on
+inline constexpr bool kHasGmemFastClear = false;                  // __info6 .has_gmem_fast_clear=False (a6xx_gen1_low)
+inline constexpr bool kConcurrentResolve = false;                 // __info6 has no .concurrent_resolve
+inline constexpr bool kHasEarlyPreamble = false;                  // __info6 has no .has_early_preamble
+inline constexpr uint32_t kNumCcu = 1;                            // __info6 .num_ccu=1
+inline constexpr uint32_t kSysmemPerCcuDepthCacheSize = 8 * 1024; // __info6 .sysmem_per_ccu_depth_cache_size=8192
+inline constexpr uint32_t kSysmemPerCcuColorCacheSize = 8 * 1024; // __info6 .sysmem_per_ccu_color_cache_size=8192
+// tiled rendering. The on-chip memory is the kernel's: this port's hw_init gives the GMEM the GPU addresses
+// 0x100000 .. 0x100000 + 0x21000 - 1 (xnu SapphireGpu.cpp hw_init_regs, UCHE_GMEM_RANGE_MIN/MAX), which is Linux's
+// A610 (a6xx_catalog.c: .gmem = SZ_128K + SZ_4K; a6xx_gpu.c: range min SZ_1M) and what Linux answers for
+// MSM_PARAM_GMEM_SIZE and MSM_PARAM_GMEM_BASE (adreno_gpu.c). turnip puts the CCU's colour cache at the end of it,
+// gmem_size - color_cache / 2 = 0x20000 (tu_device.cc:1431-1457), and tiles in what lies below (tu_pass.cc:627-628).
+// (This port's kernel answers GMEM_SIZE with 128 KB, 4 KB less than the range it programs.)
+inline constexpr uint32_t kGmemBase = 0x100000;                   // xnu SapphireGpu.cpp UCHE_GMEM_RANGE_MIN, msm_param GMEM_BASE; Linux adreno_gpu.c
+inline constexpr uint32_t kGmemBytes = 128 * 1024 + 4 * 1024;     // xnu SapphireGpu.cpp UCHE_GMEM_RANGE_MAX; Linux a6xx_catalog.c A610 .gmem
+inline constexpr uint32_t kGmemCcuColorCacheFraction = 2;         // __info6 .gmem_ccu_color_cache_fraction=1: CCUColorCacheFraction.HALF, a divisor of 2
+inline constexpr uint32_t kTileAlignW = 32, kTileAlignH = 16;     // __info6 .tile_align_w=32 .tile_align_h=16
+inline constexpr uint32_t kGmemAlignW = 16, kGmemAlignH = 4;      // __info6 .gmem_align_w=16 .gmem_align_h=4
+inline constexpr uint32_t kTileMaxW = 1024, kTileMaxH = 1008;     // __info6 .tile_max_w=1024 .tile_max_h=1008
+#else
 inline constexpr uint32_t kMagicPcPowerCntl = 1;                  // not-in-headers: freedreno_devices.h __info14 .magic.PC_POWER_CNTL
 inline constexpr uint32_t kMagicTpl1DbgEcoCntl = 0x05008000;      // not-in-headers: freedreno_devices.h __info14 .magic.TPL1_DBG_ECO_CNTL (83918848)
 inline constexpr uint32_t kMagicGrasDbgEcoCntl = 0;               // not-in-headers: freedreno_devices.h __info14 .magic.GRAS_DBG_ECO_CNTL
@@ -1410,11 +1465,13 @@ inline constexpr uint32_t kNumCcu = 2;                            // not-in-head
 inline constexpr uint32_t kSysmemPerCcuDepthCacheSize = 0x10000;  // not-in-headers: freedreno_devices.h __info14 .sysmem_per_ccu_depth_cache_size (65536)
 inline constexpr uint32_t kSysmemPerCcuColorCacheSize = 0x10000;  // not-in-headers: freedreno_devices.h __info14 .sysmem_per_ccu_color_cache_size (65536)
 // tiled rendering: the on-chip memory and the tile grid (a6xx_gen4 / adreno_7c3 in freedreno_devices.py)
+inline constexpr uint32_t kGmemBase = 0;                          // GMEM's GPU address: 0 on the A650 family and this chip (Linux adreno_gpu.c MSM_PARAM_GMEM_BASE)
 inline constexpr uint32_t kGmemBytes = 512 * 1024;                // not-in-headers: freedreno_devices.py adreno_7c3 gmem_size (Linux a6xx_gpu adreno_7c3 SZ_512K)
 inline constexpr uint32_t kGmemCcuColorCacheFraction = 4;          // not-in-headers: freedreno_devices.py a6xx_gen4 gmem_ccu_color_cache_fraction QUARTER
 inline constexpr uint32_t kTileAlignW = 32, kTileAlignH = 16;      // not-in-headers: freedreno_devices.py a6xx_gen4 tile_align_w/h
 inline constexpr uint32_t kGmemAlignW = 16, kGmemAlignH = 4;       // not-in-headers: freedreno_devices.py a6xx_gen4 gmem_align_w/h (the event blit's granule)
 inline constexpr uint32_t kTileMaxW = 1024, kTileMaxH = 1008;      // not-in-headers: freedreno_devices.py a6xx_gen4 tile_max_w/h
+#endif
 // the border color table both TP base registers point at: Gallium's is FD6_MAX_BORDER_COLORS (256) entries of
 // sizeof(struct fd6_bcolor_entry) (128 bytes: 32 fp32/fp16/int words); zeros are a valid table (black, transparent)
 inline constexpr uint32_t kBorderColorBytes = 256 * 128;          // not-in-headers: fd6_texture.h FD6_MAX_BORDER_COLORS * FD6_BORDER_COLOR_SIZE
@@ -4091,14 +4148,24 @@ constexpr uint32_t binControlGmem(bool lrzFeedback, uint32_t binw, uint32_t binh
 constexpr uint32_t kGmemCcuColorOffset = kGmemBytes - kNumCcu * kSysmemPerCcuColorCacheSize / kGmemCcuColorCacheFraction;
 constexpr uint32_t rbCcuCntlGmem() {
     return (kHasGmemFastClear ? 0u : A6XX_RB_CCU_CNTL_GMEM_FAST_CLEAR_DISABLE) | A6XX_RB_CCU_CNTL_COLOR_OFFSET_HI(kGmemCcuColorOffset >> 21) |
-           A6XX_RB_CCU_CNTL_COLOR_CACHE_SIZE(CCU_CACHE_SIZE_QUARTER) | A6XX_RB_CCU_CNTL_COLOR_OFFSET(kGmemCcuColorOffset & 0x1fffff);
+           A6XX_RB_CCU_CNTL_COLOR_CACHE_SIZE(kGmemCcuColorCacheFraction == 2 ? CCU_CACHE_SIZE_HALF : CCU_CACHE_SIZE_QUARTER) |
+           A6XX_RB_CCU_CNTL_COLOR_OFFSET(kGmemCcuColorOffset & 0x1fffff);
 }
+#if defined(HAKIOS_CHIP_A610)
+// (the A610: the colour cache in the GMEM's last 4 KB, as turnip's tu_device.cc:1456 has it for a gmem_size of 0x21000)
+static_assert(kGmemCcuColorOffset == 0x20000 && kGmemCcuColorCacheFraction == 2, "the GMEM CCU layout turnip computes for this chip");
+#else
 static_assert(rbCcuCntlGmem() == 0x3c400000, "the GMEM CCU layout turnip computes for this chip");
+#endif
 
 // hardware binning (fd6_gmem.cc emit_binning_pass, update_vsc_pipe, fd6_emit_tile_prep): the binning pass runs every draw's
 // vertex stage once over the whole window and the VSC writes, for each pipe of bins, which draws and primitives reach
 // each bin; a tile then draws only those (CP_SET_BIN_DATA5, CP_SET_VISIBILITY_OVERRIDE 0, the draws USE_VISIBILITY)
+#if defined(HAKIOS_CHIP_A610)
+inline constexpr uint32_t kNumVscPipes = 16;                      // Mesa 25.0.7 freedreno_devices.h __info6 .num_vsc_pipes=16
+#else
 inline constexpr uint32_t kNumVscPipes = 32;                      // not-in-headers: freedreno_devices.py A635 num_vsc_pipes
+#endif
 inline constexpr uint32_t REG_A6XX_VSC_BIN_SIZE = 0x0c02;                                    // a6xx.xml.h:4147  WIDTH >> 5 at 0, HEIGHT >> 4 at 8
 inline constexpr uint32_t REG_A6XX_VSC_DRAW_STRM_SIZE_ADDRESS = 0x0c03;                      // a6xx.xml.h:4164  64-bit: each pipe's draw-stream size written back
 inline constexpr uint32_t REG_A6XX_VSC_BIN_COUNT = 0x0c06;                                   // a6xx.xml.h:4167  NX at 1, NY at 11
diff --git a/hakios-metal/src/render.cpp b/hakios-metal/src/render.cpp
index d4fbfc1..46bf834 100644
--- a/hakios-metal/src/render.cpp
+++ b/hakios-metal/src/render.cpp
@@ -666,7 +666,9 @@ bool stageTextures(const Stage& fs, const Bindings& b, const RenderPass& pass, S
                 d.dword[0] |= A6XX_TEX_CONST_0_TILE_MODE(TILE6_2);
                 d.dword[2] = A6XX_TEX_CONST_2_TYPE(A6XX_TEX_2D) | A6XX_TEX_CONST_2_PITCH(gmem->binW * a.texture->info().bytesPerPixel);
                 d.dword[3] = 0;
-                d.dword[4] = gmem->base[kt.fbTarget - 1u];
+                // (the descriptor's address is a GPU address: the GMEM's own plus the attachment's place in it, as turnip's
+                // input attachments have it, tu_cmd_buffer.cc:1946 gmem_base + gmem_offset; 0 on the A635, 0x100000 on the A610)
+                d.dword[4] = kGmemBase + gmem->base[kt.fbTarget - 1u];
                 d.dword[5] &= A6XX_TEX_CONST_5_DEPTH__MASK;
                 for (uint32_t w = 6; w < 16; w++) d.dword[w] = 0;
             }
