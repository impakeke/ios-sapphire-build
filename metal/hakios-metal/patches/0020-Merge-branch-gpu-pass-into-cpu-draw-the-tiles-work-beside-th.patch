+                      REG_A6XX_RB_RAS_MSAA_CNTL == 0x8802 && REG_A6XX_RB_BLIT_GMEM_MSAA_CNTL == 0x88d5 && REG_A6XX_RB_RENDER_CNTL == 0x8801 &&
+                      REG_A6XX_GRAS_LRZ_CNTL == 0x8100 && REG_A6XX_RB_LRZ_CNTL == 0x8898 && REG_A6XX_GRAS_LRZ_BUFFER_BASE == 0x8103,
