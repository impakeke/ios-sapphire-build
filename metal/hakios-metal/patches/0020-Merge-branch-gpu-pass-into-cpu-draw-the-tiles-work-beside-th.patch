+                      REG_A6XX_SP_FS_MRT_REG == 0xa996 && REG_A6XX_GRAS_LRZ_MRT_BUF_INFO_0 == 0x8102 && REG_A6XX_RB_DITHER_CNTL == 0x880e &&
+                      REG_A6XX_RB_SRGB_CNTL == 0x880f && REG_A6XX_SP_SRGB_CNTL == 0xa98a && REG_A6XX_GRAS_MAX_LAYER_INDEX == 0x8004 &&
