+    hakios_metal_program_set_blend(p, 0, 0, 0, 1, 0, 1, 0, 0x7);   // no blending, alpha not written
+    for (int i = 0; i < 3; i++) CHECK_EQ(hakios_metal_cb_draw(cb, p, &pass, nullptr, nullptr, 3, 0, 6, 1, nullptr, nullptr, 0, nullptr, nullptr, 0), 0);
