Subject: A sysmem draw that reads its target has its own primitives in raster order

A draw whose fragment stage reads its target (framebuffer fetch, Metal's
programmable blending) was ordered in sysmem by the barrier before it alone:
the colour cache flushed and waited for, the texture caches dropped. That
orders the draw after the draws before it. Between the primitives of the draw
itself it orders nothing: a fragment over one the same draw wrote -- the
overlapping triangles of a path -- read what was there before the draw.

GRAS_SC_CNTL.SINGLE_PRIM_MODE is now FLUSH_PER_OVERLAP_AND_OVERWRITE for such a
draw, which is what both witnesses write for a sysmem draw that reads its
target (Mesa 25.0.7: fd6_emit.cc:564-570, tu_pipeline.cc:3373-3376). The
barrier stays. render::Options::fbReadOverlap, off by metal_gmem_off bit 8192
(kSysmemFetchUnordered), gives the stream as it was.

The stream changes for sysmem draws that read their target and for nothing
else: drawbench's scenes E and L and five tests' golden lines (one register's
value, and the write of it where a fetching draw follows one that is not);
what is loaded and what is named are the same sums as before.


---
diff --git a/hakios-metal/include/hakios-metal/command.hpp b/hakios-metal/include/hakios-metal/command.hpp
index e1a06fa..b0282ba 100644
--- a/hakios-metal/include/hakios-metal/command.hpp
+++ b/hakios-metal/include/hakios-metal/command.hpp
@@ -192,11 +192,12 @@ public:
     // barrier in the draws' stream, run by every tile that walks past it, kGmemAllOrdered has no barrier between
     // draws and every draw of a pass that fetches in raster order (gmem.hpp: DrawStateFetch), kGmemByDrawsAlone
     // chooses tiles or sysmem for a pass recorded both ways by its draws against the bar and nothing else
-    // (render::gmemWorth's criteria off).
+    // (render::gmemWorth's criteria off), kSysmemFetchUnordered leaves the primitives of a sysmem draw that reads its
+    // target unordered among themselves (render::Options::fbReadOverlap off).
     // (8, 16 and 32 are the plug-in's own: metal_gmem_off's untuned choice, no binning, null textures.)
     enum : uint32_t {
         kGmemWholeArea = 1, kGmemEveryAttachment = 2, kGmemFetchBarrier = 4, kGmemPlainBody = 64, kGmemNoLeave = 128, kGmemOldTiles = 256,
-        kGmemEveryBin = 512, kGmemInlineBarriers = 1024, kGmemAllOrdered = 2048, kGmemByDrawsAlone = 4096,
+        kGmemEveryBin = 512, kGmemInlineBarriers = 1024, kGmemAllOrdered = 2048, kGmemByDrawsAlone = 4096, kSysmemFetchUnordered = 8192,
     };
     void setGmemOff(uint32_t bits) { gmemOff_ = bits; }
     // GMEM or sysmem for each pass by CommandQueue::preferGmem (each pass stamped for it) rather than GMEM whenever a
diff --git a/hakios-metal/include/hakios-metal/render.hpp b/hakios-metal/include/hakios-metal/render.hpp
index 69f2694..1e56c7d 100644
--- a/hakios-metal/include/hakios-metal/render.hpp
+++ b/hakios-metal/include/hakios-metal/render.hpp
@@ -464,6 +464,8 @@ struct Options {
     bool fbReadOrdered = true;   // ...in GMEM the rasterizer's own ordering (GRAS_SC_CNTL.SINGLE_PRIM_MODE) instead, the barrier
                                  // kept for the first fetching draw after one that is not (fd6_draw.cc's rule); off: the
                                  // barrier before every fetching draw there too
+    bool fbReadOverlap = true;   // ...and in sysmem the rasterizer's ordering between the primitives of the fetching draw itself
+                                 // (SINGLE_PRIM_MODE FLUSH_PER_OVERLAP_AND_OVERWRITE), the barrier before it kept; off: NO_FLUSH
     bool tailDepthFlush = true;  // with a depth attachment: PC_CCU_FLUSH_DEPTH_TS writing a value + the wait for it
     bool tailLrzFlush = true;    // LRZ_FLUSH, 1 word
     bool tailCacheFlush = true;  // CACHE_FLUSH_TS + CP_WAIT_MEM_GTE, as compute's tail
diff --git a/hakios-metal/src/render.cpp b/hakios-metal/src/render.cpp
index 594c8b6..a2937d1 100644
--- a/hakios-metal/src/render.cpp
+++ b/hakios-metal/src/render.cpp
@@ -1774,7 +1774,13 @@ void emitDraw(S& stream, const DrawFacts& f, const Program& program, const Rende
     // ordering alone showed a widget's text cut by a band and the App Library's blur in blocks.
     // (in GMEM only: in sysmem the ordering bought nothing measurable over the barrier -- SpringBoard's heaviest passes
     // took some 50 ms either way -- and the barrier is what SpringBoard was looked at with)
+    // In sysmem the barrier stands before every fetching draw, and orders it after the draws before it. Between the
+    // primitives of the draw itself it orders nothing: a fragment over one the same draw wrote (the overlapping
+    // triangles of a path) has to read what that one left, as Metal's programmable blending does, and that is the
+    // rasterizer's to keep -- SINGLE_PRIM_MODE FLUSH_PER_OVERLAP_AND_OVERWRITE, what both witnesses give a sysmem draw
+    // that reads its target (fd6_emit.cc:564-570, tu_pipeline.cc:3373-3376).
     const bool ordered = fs.fbRead && o.fbReadOrdered && gmem != nullptr;
+    const bool overlaps = fs.fbRead && o.fbReadOverlap && gmem == nullptr;
     const bool barrier = (g & kGBarrier) && fs.fbRead && o.fbReadBarrier && (!ordered || !afterFetch);
     if (barrier && gmem != nullptr) {
         stream.waitForIdle();
@@ -2170,7 +2176,9 @@ void emitDraw(S& stream, const DrawFacts& f, const Program& program, const Rende
         // fragment over one not yet written and flushes between them (turnip's rasterization_order_attachment_access,
         // tu_pipeline.cc:3351-3380 and 3955-3983: FLUSH_PER_OVERLAP_AND_OVERWRITE in sysmem, FLUSH_PER_OVERLAP in GMEM)
         reg(stream, REG_A6XX_GRAS_SC_CNTL,
-            ordered ? A6XX_GRAS_SC_CNTL_CCUSINGLECACHELINESIZE(2) | A6XX_GRAS_SC_CNTL_SINGLE_PRIM_MODE(FLUSH_PER_OVERLAP) : grasScCntlSysmem());
+            ordered    ? A6XX_GRAS_SC_CNTL_CCUSINGLECACHELINESIZE(2) | A6XX_GRAS_SC_CNTL_SINGLE_PRIM_MODE(FLUSH_PER_OVERLAP)
+            : overlaps ? A6XX_GRAS_SC_CNTL_CCUSINGLECACHELINESIZE(2) | A6XX_GRAS_SC_CNTL_SINGLE_PRIM_MODE(FLUSH_PER_OVERLAP_AND_OVERWRITE)
+                       : grasScCntlSysmem());
         // primitive restart on for an indexed draw (Metal restarts at the all-ones index; tu6_draw_common's primitive_restart,
         // :5851-5862, which is off for a draw without indices, where the index register would be stale)
         reg(stream, REG_A6XX_PC_PRIMITIVE_CNTL_0, draw.indexBuffer != nullptr ? A6XX_PC_PRIMITIVE_CNTL_0_PRIMITIVE_RESTART : 0u);
@@ -4071,7 +4079,8 @@ void emitFast(pm4::Stream& to, CommandBuffer::RegShadow& regs, Cursor& cur, cons
     keptOf(Cursor::kLink, ps.link);
     {
         const bool ordered = ps.fbRead && o.fbReadOrdered && gmem != nullptr;
-        const uint32_t in = draw.cullMode | draw.winding << 2 | (ordered ? 8u : 0u) | (draw.indexBuffer != nullptr ? 16u : 0u);
+        const bool overlaps = ps.fbRead && o.fbReadOverlap && gmem == nullptr;
+        const uint32_t in = draw.cullMode | draw.winding << 2 | (ordered ? 8u : 0u) | (draw.indexBuffer != nullptr ? 16u : 0u) | (overlaps ? 32u : 0u);
         if (!cur.rastSet || cur.rast != in) {
             pending |= kGRast;
             cur.rast = in;
@@ -4566,6 +4575,7 @@ bool CommandBuffer::draw(const Program& program, const RenderPass& pass, const D
     const bool afterFetch = joins && open_->lastFetched;
     render::Options encodeOptions = options;
     if (gmemOff_ & kGmemFetchBarrier) encodeOptions.fbReadOrdered = false;
+    if (gmemOff_ & kSysmemFetchUnordered) encodeOptions.fbReadOverlap = false;
     // (a binned pass's draws are skipped by the tiles they miss: USE_VISIBILITY, which an override of 1 ignores)
     if (gmem && (options.gmemBinning || gmemBinning_) && queue_.binningOk() && options.gmemBinningStage < 3) encodeOptions.visCullUse = true;
     render::Options sysOptions = encodeOptions;   // (recorded both ways: the sysmem side's)
